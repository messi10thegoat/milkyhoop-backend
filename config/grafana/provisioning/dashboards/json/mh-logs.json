{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "mh-logs",
  "title": "MilkyHoop — Logs (baseline)",
  "tags": ["milkyhoop", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      },
      {
        "name": "level",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(level)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "id": 1,
      "title": "All milkyhoop service logs",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{app=\"milkyhoop\", service=~\"$service\", level=~\"$level\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Errors + warnings — rate per service (5m)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10},
          "unit": "logs/sec"
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (service) (rate({app=\"milkyhoop\", level=~\"error|warn|warning|ERROR|WARN|WARNING\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "logs",
      "id": 3,
      "title": "Errors only (last hour)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{app=\"milkyhoop\", level=~\"error|ERROR\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
