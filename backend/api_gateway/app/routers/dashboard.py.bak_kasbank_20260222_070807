            query = """
                WITH ar_journal_outstanding AS (
                    SELECT
                        si.id as invoice_id,
                        si.invoice_number,
                        si.customer_name,
                        si.due_date,
                        si.status,
                        COALESCE((
                            SELECT SUM(jl2.debit)
