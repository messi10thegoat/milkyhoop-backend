@router.get("/all")
async def get_dashboard_all(
    request: Request,
    period: str = Query("30d", regex="^(7d|30d|month)$"),
    expense_period: str = Query("30d", regex="^(7d|30d|month)$"),
):
    """
    Consolidated dashboard endpoint - returns all 4 data sets in 1 request.
    Reduces 4 HTTP calls to 1. Cached via Redis with stale-while-revalidate.

    Parameters:
    - period: Period for summary and cash flow (7d, 30d, month)
    - expense_period: Period for top expenses breakdown
    """
    try:
        if not hasattr(request.state, "user") or not request.state.user:
            raise HTTPException(status_code=401, detail="Authentication required")

        tenant_id = request.state.user.get("tenant_id")
        if not tenant_id:
            raise HTTPException(status_code=401, detail="Invalid user context")

        cache_key = f"dashboard:all:{tenant_id}:{period}:{expense_period}"

        async def fetch_all():
            """Fetch all 4 dashboard datasets in parallel."""
            try:
                summary_task = get_dashboard_summary(request, period)
                cashflow_task = get_cash_flow_trends(request, "7d")
                expenses_task = get_top_expenses(request, expense_period, 5)
                overdue_task = get_overdue_invoices(request)

                summary, cash_flow, expenses, overdue = await asyncio.gather(
                    summary_task, cashflow_task, expenses_task, overdue_task,
                    return_exceptions=True,
                )

                # Handle individual failures gracefully
                result = {}

                if isinstance(summary, Exception):
                    logger.warning(f"Dashboard summary failed: {summary}")
                    result["summary"] = None
                else:
                    result["summary"] = summary.model_dump() if hasattr(summary, 'model_dump') else (summary.dict() if hasattr(summary, 'dict') else summary)

                if isinstance(cash_flow, Exception):
                    logger.warning(f"Cash flow trends failed: {cash_flow}")
                    result["cash_flow"] = None
                else:
                    result["cash_flow"] = cash_flow.model_dump() if hasattr(cash_flow, 'model_dump') else (cash_flow.dict() if hasattr(cash_flow, 'dict') else cash_flow)

                if isinstance(expenses, Exception):
                    logger.warning(f"Top expenses failed: {expenses}")
                    result["top_expenses"] = None
                else:
                    result["top_expenses"] = expenses.model_dump() if hasattr(expenses, 'model_dump') else (expenses.dict() if hasattr(expenses, 'dict') else expenses)

                if isinstance(overdue, Exception):
                    logger.warning(f"Overdue invoices failed: {overdue}")
                    result["overdue"] = None
                else:
                    result["overdue"] = overdue.model_dump() if hasattr(overdue, 'model_dump') else (overdue.dict() if hasattr(overdue, 'dict') else overdue)

                return result

            except Exception as e:
                logger.error(f"fetch_all inner error: {e}", exc_info=True)
                raise

        # Use cache: fresh=30s, stale-while-revalidate up to 300s
        data = await cached_fetch(cache_key, fetch_all, ttl=30, stale_ttl=300)
        return data

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Dashboard /all error: {str(e)}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to get dashboard data")


