@router.post("/sessions/{session_id}/agentic-reconcile", response_model=AgenticReconcileResponse)
async def agentic_reconcile(
    request: Request,
    session_id: UUID,
    body: AgenticReconcileRequest,
):
    """
    Analyze unmatched items and generate an action plan.

    This is a deterministic analysis (not LLM-based) that:
    1. Groups unmatched items by pattern
    2. Suggests matches based on amount + description similarity
    3. Suggests categorizations for items with no matching transaction
    4. Returns an action plan for frontend confirmation
    """
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            session = await conn.fetchrow(
                "SELECT id, account_id, status FROM reconciliation_sessions WHERE id = $1 AND tenant_id = $2",
                session_id, ctx["tenant_id"],
            )
            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            # Get unmatched statement lines
            unmatched = await conn.fetch(
                """
                SELECT id, description, amount, reference, type, date as transaction_date
                FROM bank_statement_lines_v2
                WHERE session_id = $1 AND match_status = 'unmatched'
                ORDER BY date
                """,
                session_id,
            )

            # Get uncleared transactions
            uncleared = await conn.fetch(
                """
                SELECT id, description, amount, reference, source_type,
                       source_number, contact_name, contact_id, account_id,
                       transaction_date
                FROM bank_transactions
                WHERE account_id = $1 AND tenant_id = $2
                  AND is_cleared = false
                ORDER BY transaction_date
                """,
                session["account_id"], ctx["tenant_id"],
            )

            actions = []
            used_tx_ids = set()
            used_stmt_ids = set()

            # Strategy 1: Amount-exact matches not caught by earlier stages
            for stmt in unmatched:
                if str(stmt["id"]) in used_stmt_ids:
                    continue
                stmt_amount = float(stmt["amount"])

                for tx in uncleared:
                    if str(tx["id"]) in used_tx_ids:
                        continue
                    if abs(float(tx["amount"])) == abs(stmt_amount):
                        actions.append(ReconAction(
                            action_type="match",
                            statement_line_id=str(stmt["id"]),
                            transaction_id=str(tx["id"]),
                            reason=f"Jumlah sama persis: Rp {stmt_amount:,.0f}",
                            confidence="high",
                        ))
                        used_tx_ids.add(str(tx["id"]))
                        used_stmt_ids.add(str(stmt["id"]))
                        break

            # Strategy 2: Suggest categorization for remaining unmatched
            if body.include_categorize:
                for stmt in unmatched:
                    if str(stmt["id"]) in used_stmt_ids:
                        continue

                    # Check match_history for categorization hints
                    history = await conn.fetchrow(
                        """
                        SELECT transaction_account_id, transaction_contact_id,
                               transaction_source_type, COUNT(*) as cnt
                        FROM match_history
                        WHERE tenant_id = $1
                          AND statement_description_normalized = $2
                        GROUP BY transaction_account_id, transaction_contact_id,
                                 transaction_source_type
                        ORDER BY cnt DESC
                        LIMIT 1
                        """,
                        ctx["tenant_id"],
                        normalize_bank_text(stmt["description"] or ""),
                    )

                    if history and history["transaction_account_id"]:
                        actions.append(ReconAction(
                            action_type="categorize",
                            statement_line_id=str(stmt["id"]),
                            category_account_id=str(history["transaction_account_id"]),
                            category_description=stmt["description"],
                            reason=f"Berdasarkan {history['cnt']} match sebelumnya",
                            confidence="medium",
                        ))
                        used_stmt_ids.add(str(stmt["id"]))

            # Strategy 3: Suggest exclude for very small amounts
            if body.include_exclude:
                for stmt in unmatched:
                    if str(stmt["id"]) in used_stmt_ids:
                        continue
                    if abs(float(stmt["amount"])) < 1000:  # less than Rp 1,000
                        actions.append(ReconAction(
                            action_type="exclude",
                            statement_line_id=str(stmt["id"]),
                            reason=f"Jumlah kecil: Rp {abs(float(stmt['amount'])):,.0f}",
                            confidence="low",
                        ))
                        used_stmt_ids.add(str(stmt["id"]))

            # Limit actions
            actions = actions[:body.max_actions]

            plan = ReconActionPlan(
                actions=actions,
                summary=f"{len(actions)} aksi direkomendasikan untuk {len(unmatched)} item belum dicocokkan",
                total_actions=len(actions),
                estimated_resolution=len([a for a in actions if a.action_type == "match"]),
            )

            stats = await get_session_statistics(conn, session_id)

            return AgenticReconcileResponse(
                action_plan=plan,
                session_stats=stats,
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error in agentic reconcile: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to generate action plan")


@router.post("/sessions/{session_id}/confirm-batch", response_model=ConfirmBatchResponse)
async def confirm_batch(
    request: Request,
    session_id: UUID,
    body: ConfirmBatchRequest,
):
    """Confirm a batch of reconciliation actions (match, exclude)."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            session = await conn.fetchrow(
                "SELECT status, account_id FROM reconciliation_sessions WHERE id = $1 AND tenant_id = $2",
                session_id, ctx["tenant_id"],
            )
            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            confirmed = 0
            failed = 0
            errors = []
            now = datetime.utcnow()

            async with conn.transaction():
                for action in body.actions:
                    try:
                        if action.action_type == "match" and action.transaction_id:
                            stmt_id = UUID(action.statement_line_id)
                            tx_id = UUID(action.transaction_id)

                            # Verify both exist and are available
                            stmt = await conn.fetchrow(
                                "SELECT id, match_status FROM bank_statement_lines_v2 WHERE id = $1 AND session_id = $2",
                                stmt_id, session_id,
                            )
                            if not stmt or stmt["match_status"] == "matched":
                                errors.append(f"Statement {action.statement_line_id} not available")
                                failed += 1
                                continue

                            tx = await conn.fetchrow(
                                "SELECT id, is_cleared FROM bank_transactions WHERE id = $1 AND tenant_id = $2",
                                tx_id, ctx["tenant_id"],
                            )
                            if not tx or tx["is_cleared"]:
                                errors.append(f"Transaction {action.transaction_id} not available")
                                failed += 1
                                continue

                            # Create match
                            match_id = uuid.uuid4()
                            await conn.execute(
                                """
                                INSERT INTO reconciliation_matches (
                                    id, tenant_id, session_id, statement_line_id, transaction_id,
                                    match_type, confidence, created_by, created_at
                                ) VALUES ($1, $2, $3, $4, $5, 'one_to_one', $6, $7, NOW())
                                """,
                                match_id, ctx["tenant_id"], session_id,
                                stmt_id, tx_id, action.confidence, ctx["user_id"],
                            )

                            await conn.execute(
                                "UPDATE bank_transactions SET is_cleared = true, cleared_at = $2, matched_statement_line_id = $3 WHERE id = $1",
                                tx_id, now, stmt_id,
                            )
                            await conn.execute(
                                "UPDATE bank_statement_lines_v2 SET match_status = 'matched' WHERE id = $1",
                                stmt_id,
                            )

                            await record_match_history(conn, ctx["tenant_id"], session_id, stmt_id, tx_id, action.confidence, "batch", ctx["user_id"])
                            confirmed += 1

                        elif action.action_type == "exclude":
                            stmt_id = UUID(action.statement_line_id)
                            await conn.execute(
                                "UPDATE bank_statement_lines_v2 SET match_status = 'excluded' WHERE id = $1",
                                stmt_id,
                            )
                            confirmed += 1

                    except Exception as e:
                        errors.append(str(e))
                        failed += 1

                await update_reconciliation_session_stats(conn, session_id)

            stats = await get_session_statistics(conn, session_id)

            return ConfirmBatchResponse(
                confirmed=confirmed,
                failed=failed,
                errors=errors,
                session_stats=stats,
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error confirming batch: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to confirm batch")


