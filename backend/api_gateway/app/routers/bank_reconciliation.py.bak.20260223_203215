@router.post("/sessions/{session_id}/auto-match", response_model=AutoMatchResponse)
async def auto_match(
    request: Request,
    session_id: UUID,
    body: Optional[AutoMatchRequest] = None,
):
    """
    Run auto-matching algorithm on unmatched statement lines.

    Matching rules:
    - exact: Same date and amount
    - high: Amount matches, date within 3 days
    - medium: Amount matches within 5%, date within 7 days
    - low: Partial match on description/reference
    """
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        if body is None:
            body = AutoMatchRequest()

        date_tolerance = body.date_tolerance_days
        confidence_threshold = body.confidence_threshold

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Verify session
            session = await conn.fetchrow(
                """
                SELECT status, account_id, statement_start_date, statement_end_date
                FROM reconciliation_sessions WHERE id = $1 AND tenant_id = $2
                """,
                session_id,
                ctx["tenant_id"],
            )

            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            if session["status"] != "in_progress":
                raise HTTPException(
                    status_code=400,
                    detail="Can only auto-match in in-progress sessions",
                )

            # Get unmatched statement lines
            unmatched_lines = await conn.fetch(
                """
                SELECT id, date as transaction_date, description, reference, amount, CASE WHEN type = 'credit' THEN true ELSE false END as is_credit
                FROM bank_statement_lines_v2
                WHERE session_id = $1 AND match_status = 'unmatched'
                ORDER BY transaction_date
                """,
                session_id,
            )

            # Get uncleared transactions
            uncleared_txs = await conn.fetch(
                """
                SELECT id, transaction_date, description, reference_number as reference, amount, CASE WHEN amount >= 0 THEN true ELSE false END as is_credit
                FROM bank_transactions
                WHERE bank_account_id = $1
                  AND tenant_id = $2
                  AND transaction_date BETWEEN $3 AND GREATEST($4::date, COALESCE(
                    (SELECT MAX(bsl.date::date) FROM bank_statement_lines_v2 bsl WHERE bsl.session_id = $5::uuid),
                    $4::date
                  ))
                  AND is_cleared = false
                ORDER BY transaction_date
                """,
                session["account_id"],
                ctx["tenant_id"],
                session["statement_start_date"],
                session["statement_end_date"],
                str(session_id),
            )

            matches_created = 0
            suggestions: list = []
            now = datetime.utcnow()

            # =============================================
            # STAGE 2: Bank Rules Engine
            # =============================================
            # Load active rules for this tenant
            rule_rows = await conn.fetch(
                """
                SELECT id, tenant_id, name, description, is_active, sort_order, rule_type,
                       bank_account_id, direction, condition_logic, conditions,
                       contact_id, account_id, tax_rate_id, allocations,
                       times_applied
                FROM bank_matching_rules
                WHERE tenant_id = $1 AND is_active = true
                ORDER BY sort_order
                """,
                ctx["tenant_id"],
            )

            rules = [BankRule.from_row(dict(r)) for r in rule_rows]
            rule_matched_line_ids = set()

            if rules:
                for line in unmatched_lines:
                    stmt_dict = {
                        "description": line["description"] or "",
                        "amount": float(line["amount"]),
                        "date": str(line["transaction_date"]),
                        "reference": line["reference"] or "",
                        "type": "credit" if line["is_credit"] else "debit",
                    }

                    result = evaluate_rules(rules, stmt_dict, str(session["account_id"]))

                    if result.matched and result.action:
                        # Try to find a matching transaction based on rule action
                        matched_tx = None
                        for tx in uncleared_txs:
                            # Compare absolute amounts and verify direction
                            line_amount = abs(float(line["amount"]))
                            tx_amount = abs(float(tx["amount"]))
                            if line_amount == tx_amount:
                                # Verify direction: debit line = outflow (negative tx), credit line = inflow (positive tx)
                                tx_is_outflow = float(tx["amount"]) < 0
                                line_is_outflow = not line["is_credit"]
                                if tx_is_outflow == line_is_outflow:
                                    matched_tx = tx
                                    break

                        if matched_tx:
                            match_id = uuid.uuid4()
                            await conn.execute(
                                """
                                INSERT INTO reconciliation_matches (
                                    id, tenant_id, session_id, statement_line_id, transaction_id,
                                    match_type, confidence, created_by, created_at
                                ) VALUES ($1, $2, $3, $4, $5, 'one_to_one', 'high', $6, NOW())
                                """,
                                match_id, ctx["tenant_id"], session_id,
                                line["id"], matched_tx["id"], ctx["user_id"],
                            )

                            await conn.execute(
                                """
                                UPDATE bank_transactions
                                SET is_cleared = true, cleared_at = $2, matched_statement_line_id = $3
                                WHERE id = $1
                                """,
                                matched_tx["id"], now, line["id"],
                            )

                            await conn.execute(
                                """
                                UPDATE bank_statement_lines_v2
                                SET match_status = 'matched'
                                WHERE id = $1
                                """,
                                line["id"],
                            )

                            # Update rule stats
                            await conn.execute(
                                """
                                UPDATE bank_matching_rules
                                SET times_applied = times_applied + 1, last_applied_at = NOW()
                                WHERE id = $1
                                """,
                                uuid.UUID(result.rule_id),
                            )

                            matches_created += 1
                            await record_match_history(conn, ctx["tenant_id"], session_id, line["id"], matched_tx["id"], "high", "rule", ctx["user_id"])
                            rule_matched_line_ids.add(line["id"])
                            uncleared_txs = [tx for tx in uncleared_txs if tx["id"] != matched_tx["id"]]

                # Filter out rule-matched lines from the scoring loop
                unmatched_lines = [l for l in unmatched_lines if l["id"] not in rule_matched_line_ids]

            # =============================================
            # STAGE 3: Fuzzy Scoring
            # =============================================
            for line in unmatched_lines:
                best_match = None
                best_confidence = None
                best_score = 0.0
                match_reasons = []

                # Build statement line dict for scorer
                stmt_dict = {
                    "description": line["description"] or "",
                    "amount": float(line["amount"]),
                    "date": str(line["transaction_date"]),
                    "reference": line["reference"] or "",
                }

                for tx in uncleared_txs:
                    # Build transaction dict for scorer
                    txn_dict = {
                        "description": tx["description"] or "",
                        "amount": float(tx["amount"]),
                        "date": str(tx["transaction_date"]),
                        "reference": tx["reference"] or "",
                        "source_number": tx.get("source_number") or "",
                        "contact_name": tx.get("contact_name") or "",
                    }

                    # Use new multi-factor scorer
                    score_result = compute_match_score(stmt_dict, txn_dict)

                    # Build human-readable reasons from score breakdown
                    reasons = []
                    if score_result.amount_score >= 0.9:
                        reasons.append("Exact amount match")
                    elif score_result.amount_score >= 0.7:
                        reasons.append("Amount within 5%")
                    elif score_result.amount_score >= 0.4:
                        reasons.append("Amount within 10%")

                    if score_result.reference_score >= 0.9:
                        reasons.append("Reference match")
                    elif score_result.reference_score >= 0.5:
                        reasons.append("Partial reference match")

                    if score_result.text_score >= 0.7:
                        reasons.append("Description/contact match")
                    elif score_result.text_score >= 0.4:
                        reasons.append("Partial text match")

                    if score_result.date_score >= 0.9:
                        reasons.append("Exact date match")
                    elif score_result.date_score >= 0.5:
                        reasons.append("Date within 3 days")
                    elif score_result.date_score > 0:
                        reasons.append("Date within 7 days")

                    if score_result.total_score > best_score:
                        best_score = score_result.total_score
                        best_match = tx
                        best_confidence = score_result.confidence
                        match_reasons = reasons

                if best_match and best_confidence and best_confidence != "low":
                    # Check if we should auto-match or suggest
                    confidence_order = ["exact", "high", "medium", "low"]
                    threshold_idx = confidence_order.index(confidence_threshold)
                    match_idx = confidence_order.index(best_confidence)

                    if match_idx <= threshold_idx:
                        # Auto-match
                        match_id = uuid.uuid4()
                        await conn.execute(
                            """
                            INSERT INTO reconciliation_matches (
                                id, tenant_id, session_id, statement_line_id, transaction_id,
                                match_type, confidence, created_by, created_at
                            ) VALUES ($1, $2, $3, $4, $5, 'one_to_one', $6, $7, NOW())
                            """,
                            match_id,
                            ctx["tenant_id"],
                            session_id,
                            line["id"],
                            best_match["id"],
                            best_confidence,
                            ctx["user_id"],
                        )

                        await conn.execute(
                            """
                            UPDATE bank_transactions
                            SET is_cleared = true,
                                cleared_at = $2,
                                matched_statement_line_id = $3
                            WHERE id = $1
                            """,
                            best_match["id"],
                            now,
                            line["id"],
                        )

                        await conn.execute(
                            """
                            UPDATE bank_statement_lines_v2
                            SET match_status = 'matched'
                            WHERE id = $1
                            """,
                            line["id"],
                        )

                        matches_created += 1
                        await record_match_history(conn, ctx["tenant_id"], session_id, line["id"], best_match["id"], best_confidence, "auto", ctx["user_id"])

                        # Remove from available transactions
                        uncleared_txs = [
                            tx for tx in uncleared_txs if tx["id"] != best_match["id"]
                        ]
                    else:
                        # Add suggestion
                        suggestions.append(
                            MatchSuggestion(
                                statement_line_id=str(line["id"]),
                                suggested_transaction_ids=[str(best_match["id"])],
                                confidence=best_confidence,
                                confidence_score=best_score,
                                match_reasons=match_reasons,
                            )
                        )

            # =============================================
            # STAGE 4: History Learning
            # =============================================
            # Query past match_history to suggest matches for remaining unmatched lines
            history_matched_line_ids = set()

            if unmatched_lines and uncleared_txs:
                for line in unmatched_lines:
                    stmt_desc = line["description"] or ""
                    stmt_normalized = normalize_bank_text(stmt_desc)
                    stmt_amount = float(line["amount"])

                    if not stmt_normalized:
                        continue

                    # Find past matches with similar description
                    history_rows = await conn.fetch(
                        """
                        SELECT DISTINCT ON (transaction_contact_id, transaction_account_id)
                               transaction_description, transaction_amount,
                               transaction_source_type, transaction_contact_name,
                               transaction_contact_id, transaction_account_id,
                               match_confidence, COUNT(*) as match_count
                        FROM match_history
                        WHERE tenant_id = $1
                          AND statement_description_normalized = $2
                        GROUP BY transaction_description, transaction_amount,
                                 transaction_source_type, transaction_contact_name,
                                 transaction_contact_id, transaction_account_id,
                                 match_confidence
                        ORDER BY transaction_contact_id, transaction_account_id, match_count DESC
                        LIMIT 5
                        """,
                        ctx["tenant_id"],
                        stmt_normalized,
                    )

                    if not history_rows:
                        continue

                    # Try to find a matching transaction from history pattern
                    for hist in history_rows:
                        best_tx = None
                        best_score = 0.0

                        for tx in uncleared_txs:
                            score = 0.0
                            # Amount match (use abs to handle sign differences)
                            if abs(float(tx["amount"])) == abs(stmt_amount):
                                score += 0.5
                            elif abs(abs(float(tx["amount"])) - abs(stmt_amount)) / max(abs(stmt_amount), 1) < 0.05:
                                score += 0.3

                            # Contact match
                            if hist["transaction_contact_id"] and tx.get("contact_id") == hist["transaction_contact_id"]:
                                score += 0.3

                            # Source type match
                            if hist["transaction_source_type"] and tx.get("source_type") == hist["transaction_source_type"]:
                                score += 0.2

                            if score > best_score and score >= 0.5:
                                best_score = score
                                best_tx = tx

                        if best_tx:
                            # High confidence if seen 3+ times, medium otherwise
                            confidence = "high" if int(hist["match_count"]) >= 3 else "medium"

                            # Auto-match if high confidence
                            if confidence == "high":
                                match_id = uuid.uuid4()
                                await conn.execute(
                                    """
                                    INSERT INTO reconciliation_matches (
                                        id, tenant_id, session_id, statement_line_id, transaction_id,
                                        match_type, confidence, created_by, created_at
                                    ) VALUES ($1, $2, $3, $4, $5, 'one_to_one', $6, $7, NOW())
                                    """,
                                    match_id, ctx["tenant_id"], session_id,
                                    line["id"], best_tx["id"], confidence, ctx["user_id"],
                                )

                                await conn.execute(
                                    """
                                    UPDATE bank_transactions
                                    SET is_cleared = true, cleared_at = $2, matched_statement_line_id = $3
                                    WHERE id = $1
                                    """,
                                    best_tx["id"], now, line["id"],
                                )

                                await conn.execute(
                                    """
                                    UPDATE bank_statement_lines_v2
                                    SET match_status = 'matched'
                                    WHERE id = $1
                                    """,
                                    line["id"],
                                )

                                matches_created += 1
                                await record_match_history(conn, ctx["tenant_id"], session_id, line["id"], best_tx["id"], confidence, "history", ctx["user_id"])
                                history_matched_line_ids.add(line["id"])
                                uncleared_txs = [tx for tx in uncleared_txs if tx["id"] != best_tx["id"]]
                                break
                            else:
                                # Add as suggestion
                                suggestions.append(
                                    MatchSuggestion(
                                        statement_line_id=str(line["id"]),
                                        suggested_transaction_ids=[str(best_tx["id"])],
                                        confidence=confidence,
                                        confidence_score=best_score,
                                        match_reasons=[f"History: similar to {int(hist['match_count'])} past matches"],
                                    )
                                )
                                break

                # Filter out history-matched lines
                unmatched_lines = [l for l in unmatched_lines if l["id"] not in history_matched_line_ids]

                if history_matched_line_ids:
                    logger.info(f"Stage 4: History learning matched {len(history_matched_line_ids)} lines")

            # =============================================
            # STAGE 5: Combination Match (one-to-many / many-to-one)
            # =============================================
            combo_suggestions = []

            # Re-fetch unmatched lines after fuzzy scoring
            remaining_lines = [l for l in unmatched_lines if l["id"] not in {
                uuid.UUID(s.statement_line_id) if isinstance(s.statement_line_id, str) else s.statement_line_id
                for s in suggestions
            }]

            if remaining_lines and uncleared_txs:
                combo_stmt_items = [
                    CombinationItem(
                        id=str(l["id"]),
                        amount=float(l["amount"]),
                        description=l["description"] or "",
                        date=str(l["transaction_date"]),
                    )
                    for l in remaining_lines
                ]
                combo_txn_items = [
                    CombinationItem(
                        id=str(t["id"]),
                        amount=float(t["amount"]),
                        description=t["description"] or "",
                        date=str(t["transaction_date"]),
                    )
                    for t in uncleared_txs
                ]

                combo_results = find_combination_matches(combo_stmt_items, combo_txn_items)

                for cr in combo_results:
                    combo_suggestions.append(CombinationSuggestionSchema(
                        match_type=cr.match_type,
                        target_id=cr.target_id,
                        target_amount=cr.target_amount,
                        combined_ids=cr.combined_ids,
                        combined_amounts=cr.combined_amounts,
                        combined_total=cr.combined_total,
                        difference=cr.difference,
                        confidence=cr.confidence,
                        item_count=cr.item_count,
                        description=cr.description,
                    ))

                logger.info(f"Stage 5: Found {len(combo_suggestions)} combination suggestions")

            # Update session stats
            await update_reconciliation_session_stats(conn, session_id)

            # Get updated stats
            stats = await get_session_statistics(conn, session_id)

            return AutoMatchResponse(
                matches_created=matches_created,
                suggestions=suggestions,
                combination_suggestions=combo_suggestions,
                session_stats=stats,
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error auto-matching: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to auto-match")


@router.post(
    "/sessions/{session_id}/transactions", response_model=CreateTransactionResponse
)
async def create_transaction_from_line(
    request: Request,
    session_id: UUID,
    body: CreateTransactionFromLineRequest,
):
    """Create a bank transaction from an unmatched statement line."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Verify session
            session = await conn.fetchrow(
                "SELECT status, account_id FROM reconciliation_sessions WHERE id = $1 AND tenant_id = $2",
                session_id,
                ctx["tenant_id"],
            )

            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            if session["status"] != "in_progress":
                raise HTTPException(
                    status_code=400,
                    detail="Can only create transactions in in-progress sessions",
                )

            # Get statement line
            statement_line = await conn.fetchrow(
                """
                SELECT id, date as transaction_date, description, reference, amount, CASE WHEN type = 'credit' THEN true ELSE false END as is_credit, match_status
                FROM bank_statement_lines_v2
                WHERE id = $1 AND session_id = $2
                """,
                UUID(body.statement_line_id),
                session_id,
            )

            if not statement_line:
                raise HTTPException(status_code=404, detail="Statement line not found")

            if statement_line["match_status"] == "matched":
                raise HTTPException(
                    status_code=400, detail="Statement line is already matched"
                )

            # Verify account exists
            account = await conn.fetchrow(
                "SELECT id FROM chart_of_accounts WHERE id = $1 AND tenant_id = $2",
                UUID(body.account_id),
                ctx["tenant_id"],
            )

            if not account:
                raise HTTPException(
                    status_code=404, detail="Chart of accounts entry not found"
                )

            # Create transaction with proper journal (Iron Law 23: Atomic)
            tx_id = uuid.uuid4()
            now = datetime.utcnow()
            is_credit = statement_line["is_credit"]

            # Get bank CoA from bank_account
            bank_acct = await conn.fetchrow(
                "SELECT coa_id, name FROM bank_accounts WHERE id = $1 AND tenant_id = $2",
                session["account_id"], ctx["tenant_id"],
            )
            if not bank_acct or not bank_acct["coa_id"]:
                raise HTTPException(status_code=400, detail="Bank account has no linked COA")

            bank_coa_id = bank_acct["coa_id"]
            contra_account_id = UUID(body.account_id)
            stmt_amount = abs(statement_line["amount"])

            # Create journal entry
            journal_id = uuid.uuid4()
            posting_date = statement_line["transaction_date"]
            journal_number = f"RECON-TX-{posting_date.strftime('%Y%m%d') if hasattr(posting_date, 'strftime') else posting_date}-{str(tx_id)[:8].upper()}"

            await conn.execute(
                """
                INSERT INTO journal_entries (
                    id, tenant_id, journal_number, journal_date, description,
                    source_type, source_id, status, total_debit, total_credit,
                    created_by, created_at, updated_at
                ) VALUES ($1, $2, $3, $4, $5, 'RECONCILIATION_TRANSACTION', $6, 'POSTED', $7, $7, $8, NOW(), NOW())
                """,
                journal_id, ctx["tenant_id"], journal_number, posting_date,
                body.description or statement_line["description"],
                UUID(body.statement_line_id), stmt_amount, ctx["user_id"],
            )

            # Journal lines: inflow (credit stmt) = Dr Bank, Cr Contra
            #                outflow (debit stmt) = Dr Contra, Cr Bank
            if is_credit:
                debit_acct, credit_acct = bank_coa_id, contra_account_id
            else:
                debit_acct, credit_acct = contra_account_id, bank_coa_id

            await conn.execute(
                """INSERT INTO journal_lines (id, journal_id, line_number, account_id, debit, credit, memo)
                   VALUES ($1, $2, 1, $3, $4, 0, $5)""",
                uuid.uuid4(), journal_id, debit_acct, stmt_amount,
                body.description or statement_line["description"],
            )
            await conn.execute(
                """INSERT INTO journal_lines (id, journal_id, line_number, account_id, debit, credit, memo)
                   VALUES ($1, $2, 2, $3, 0, $4, $5)""",
                uuid.uuid4(), journal_id, credit_acct, stmt_amount,
                body.description or statement_line["description"],
            )

            # Create bank_transaction with journal linkage
            # Sign convention: positive = inflow (credit), negative = outflow (debit)
            bank_amount = int(stmt_amount) if is_credit else -int(stmt_amount)
            tx_type = "deposit" if is_credit else "withdrawal"

            tx_id = await create_bank_transaction_for_journal(
                conn,
                tenant_id=ctx["tenant_id"],
                bank_account_id=session["account_id"],
                journal_id=journal_id,
                transaction_date=posting_date,
                transaction_type=tx_type,
                amount=bank_amount,
                reference_type="reconciliation",
                reference_id=UUID(body.statement_line_id),
                description=body.description or statement_line["description"],
                payee_payer=None,
                created_by=ctx["user_id"],
            )

            match_id = None
            if body.auto_match:
                # Auto-match the created transaction
                match_id = uuid.uuid4()
                await conn.execute(
                    """
                    INSERT INTO reconciliation_matches (
                        id, tenant_id, session_id, statement_line_id, transaction_id,
                        match_type, confidence, created_by, created_at
                    ) VALUES ($1, $2, $3, $4, $5, 'one_to_one', 'manual', $6, NOW())
                    """,
                    match_id,
                    ctx["tenant_id"],
                    session_id,
                    UUID(body.statement_line_id),
                    tx_id,
                    ctx["user_id"],
                )

                await conn.execute(
                    """
                    UPDATE bank_transactions
                    SET is_cleared = true,
                        cleared_at = $2,
                        matched_statement_line_id = $3
                    WHERE id = $1
                    """,
                    tx_id,
                    now,
                    UUID(body.statement_line_id),
                )

                await conn.execute(
                    """
                    UPDATE bank_statement_lines_v2
                    SET match_status = 'matched'
                    WHERE id = $1
                    """,
                    UUID(body.statement_line_id),
                )

            # Update session stats
            await update_reconciliation_session_stats(conn, session_id)

            # Get updated stats
            stats = await get_session_statistics(conn, session_id)

            return CreateTransactionResponse(
                transaction_id=str(tx_id),
                match_id=str(match_id) if match_id else None,
                session_stats=stats,
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error creating transaction: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to create transaction")


