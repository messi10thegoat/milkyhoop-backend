        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            row = await conn.fetchrow(
                """
                SELECT
                    rs.*,
                    ba.account_name,
                    ba.account_number
                FROM reconciliation_sessions rs
