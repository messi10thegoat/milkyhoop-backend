async def generate_reconciliation_summary(conn, session_id, tenant_id) -> dict:
    """Generate full reconciliation summary with balance proof."""
    session = await conn.fetchrow(
        """
        SELECT rs.*, ba.account_name
        FROM reconciliation_sessions rs
        LEFT JOIN bank_accounts ba ON ba.id = rs.account_id AND ba.tenant_id = rs.tenant_id
        WHERE rs.id = $1 AND rs.tenant_id = $2
        """,
        session_id, tenant_id,
    )
    if not session:
        return None

    # Count by match status
    status_counts = await conn.fetch(
        """
        SELECT match_status, COUNT(*) as cnt
        FROM bank_statement_lines_v2
        WHERE session_id = $1
        GROUP BY match_status
        """,
        session_id,
    )
    counts = {r["match_status"]: r["cnt"] for r in status_counts}

    # Match methods breakdown from match_history
    method_counts = await conn.fetch(
        """
        SELECT match_method, COUNT(*) as cnt
        FROM match_history
        WHERE session_id = $1 AND tenant_id = $2
        GROUP BY match_method
        """,
        session_id, tenant_id,
    )
    match_methods = {r["match_method"]: r["cnt"] for r in method_counts}

    # Balance proof
    statement_ending = float(session["statement_ending_balance"] or 0)
    ledger_balance = float(session.get("ledger_balance") or 0)

    cleared_sum = await conn.fetchval(
        """
        SELECT COALESCE(SUM(CASE WHEN type = 'credit' THEN amount ELSE -amount END), 0)
        FROM bank_statement_lines_v2
        WHERE session_id = $1 AND match_status = 'matched'
        """,
        session_id,
    )
    cleared_balance = float(cleared_sum or 0)

    uncleared_sum = await conn.fetchval(
        """
        SELECT COALESCE(SUM(CASE WHEN type = 'credit' THEN amount ELSE -amount END), 0)
        FROM bank_statement_lines_v2
        WHERE session_id = $1 AND match_status IN ('unmatched', 'excluded')
        """,
        session_id,
    )
    uncleared_balance = float(uncleared_sum or 0)

    difference = statement_ending - ledger_balance if ledger_balance != 0 else 0

    total = sum(counts.values())
    matched = counts.get("matched", 0)
    unmatched = counts.get("unmatched", 0)
    excluded = counts.get("excluded", 0)

    # Categorized = matched via categorize method
    categorized = match_methods.get("categorize", 0)

    # Can complete?
    blockers = []
    if unmatched > 0:
        blockers.append(f"{unmatched} item belum dicocokkan")
    if abs(difference) > 0.01 and ledger_balance != 0:
        blockers.append(f"Selisih Rp {abs(difference):,.0f}")

    return {
        "session_id": str(session_id),
        "account_name": session["account_name"],
        "status": session["status"],
        "total_statement_lines": total,
        "matched_count": matched,
        "unmatched_count": unmatched,
        "excluded_count": excluded,
        "categorized_count": categorized,
        "balance_proof": {
            "statement_ending_balance": statement_ending,
            "ledger_balance": ledger_balance,
            "cleared_balance": cleared_balance,
            "uncleared_balance": uncleared_balance,
            "difference": difference,
            "is_balanced": abs(difference) < 0.01 or ledger_balance == 0,
        },
        "match_methods": match_methods,
        "can_complete": len(blockers) == 0,
        "completion_blockers": blockers,
    }


@router.get("/sessions/{session_id}/summary", response_model=ReconciliationSummaryResponse)
async def get_reconciliation_summary(
    request: Request,
    session_id: UUID,
):
    """Get full reconciliation summary with balance proof."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            summary = await generate_reconciliation_summary(conn, session_id, ctx["tenant_id"])
            if not summary:
                raise HTTPException(status_code=404, detail="Session not found")

            return ReconciliationSummaryResponse(**summary)

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error getting summary: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to get summary")
