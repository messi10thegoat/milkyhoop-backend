@router.get("/sessions/{session_id}/transactions", response_model=TransactionsResponse)
async def list_transactions(
    request: Request,
    session_id: UUID,
    is_cleared: Optional[bool] = Query(None),
    type: Optional[str] = Query(None),
    search: Optional[str] = Query(None),
    offset: int = Query(0, ge=0),
    limit: int = Query(50, ge=1, le=200),
):
    """List system transactions for matching within session date range."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Get session details
            session = await conn.fetchrow(
                """
                SELECT account_id, statement_start_date, statement_end_date
                FROM reconciliation_sessions
                WHERE id = $1 AND tenant_id = $2
                """,
                session_id,
                ctx["tenant_id"],
            )

            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            conditions = [
                "bt.bank_account_id = $1",
                "bt.tenant_id = $2",
                "bt.transaction_date >= $3",
                "bt.transaction_date <= GREATEST($4::date, COALESCE((SELECT MAX(bsl.date::date) FROM bank_statement_lines_v2 bsl WHERE bsl.session_id = $5::uuid), $4::date))",
                "bt.status = 'POSTED'",
                "(bt.is_reconciled = false OR bt.is_reconciled IS NULL OR bt.reconciled_session_id = $6::uuid)",
            ]
            params = [
                session["account_id"],
                ctx["tenant_id"],
                session["statement_start_date"],
                session["statement_end_date"],
                str(session_id),
                session_id,
            ]
            param_idx = 7

            if is_cleared is not None:
                conditions.append(f"bt.is_cleared = ${param_idx}")
                params.append(is_cleared)
                param_idx += 1

            if type:
                conditions.append(f"bt.transaction_type = ${param_idx}")
                params.append(type)
                param_idx += 1

            if search:
                conditions.append(
                    f"(bt.description ILIKE ${param_idx} OR bt.reference_number ILIKE ${param_idx})"
                )
                params.append(f"%{search}%")
                param_idx += 1

            where_clause = " AND ".join(conditions)

            total = await conn.fetchval(
                f"SELECT COUNT(*) FROM bank_transactions bt WHERE {where_clause}",
                *params,
            )

            params.extend([limit, offset])
            rows = await conn.fetch(
                f"""
                SELECT
                    bt.id,
                    bt.transaction_type,
                    bt.transaction_date,
                    bt.description,
                    bt.reference_number,
                    bt.amount,
                    CASE WHEN bt.amount >= 0 THEN true ELSE false END as is_credit,
                    bt.reference_type as source_type,
                    bt.reference_id as source_id,
                    bt.reference_number as source_number,
                    bt.is_cleared,
                    bt.matched_statement_line_id,
                    bt.payee_payer as contact_name,
                    bt.reconciled_session_id
                FROM bank_transactions bt
                WHERE {where_clause}
                ORDER BY bt.transaction_date DESC, bt.created_at DESC
                LIMIT ${param_idx} OFFSET ${param_idx + 1}
                """,
                *params,
            )

            transactions = []
            for row in rows:
                # Get match ID if matched
                match_id = None
                if row["matched_statement_line_id"]:
                    match_row = await conn.fetchval(
                        "SELECT id FROM reconciliation_matches WHERE statement_line_id = $1",
                        row["matched_statement_line_id"],
                    )
                    if match_row:
                        match_id = str(match_row)

                transactions.append(
                    TransactionItem(
                        id=str(row["id"]),
                        transaction_type=row["transaction_type"] or "other",
                        transaction_date=str(row["transaction_date"]),
                        description=row["description"],
                        reference=row['reference_number'],
                        amount=row["amount"],
                        is_credit=row["is_credit"],
                        source_type=row["source_type"] or "manual",
                        source_id=str(row["source_id"]) if row["source_id"] else None,
                        source_number=row["source_number"],
                        contact_name=row["contact_name"],
                        is_matched=row["is_cleared"] or False,
                        match_id=match_id,
                        cleared_in_session=(str(row["reconciled_session_id"]) == str(session_id)) if row["reconciled_session_id"] else False,
                    )
                )

            return TransactionsResponse(
                data=transactions, total=total, hasMore=(offset + limit) < total
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error listing transactions: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to list transactions")




# =============================================================================
# HELPER: Adjustment Journal Line Direction Logic
# =============================================================================

def compute_adjustment_journal_lines(
    difference: float,
    statement_line_type: str,
    adjustment_account_id: str,
    bank_coa_id: str,
) -> list:
    """
    Compute debit/credit lines for a reconciliation adjustment journal.

    INFLOW (statement credit):
      difference > 0 -> bank received MORE -> Debit: Bank, Credit: Adjustment
      difference < 0 -> bank received LESS -> Debit: Adjustment, Credit: Bank
    OUTFLOW (statement debit):
      difference > 0 -> bank paid MORE -> Debit: Adjustment, Credit: Bank
      difference < 0 -> bank paid LESS -> Debit: Bank, Credit: Adjustment
    """
    is_inflow = statement_line_type == "credit"
    abs_diff = abs(difference)

    if difference > 0:
        debit_account = bank_coa_id if is_inflow else adjustment_account_id
        credit_account = adjustment_account_id if is_inflow else bank_coa_id
    else:
        debit_account = adjustment_account_id if is_inflow else bank_coa_id
        credit_account = bank_coa_id if is_inflow else adjustment_account_id

    return [
        {"account_id": debit_account, "debit": abs_diff, "credit": 0},
        {"account_id": credit_account, "debit": 0, "credit": abs_diff},
    ]


@router.post("/sessions/{session_id}/match", response_model=MatchResponse)
async def create_match(
    request: Request,
    session_id: UUID,
    body: MatchRequest,
):
    """Create a match between a statement line and one or more transactions."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")


            async with conn.transaction():
                session = await conn.fetchrow(
                    "SELECT status, account_id FROM reconciliation_sessions WHERE id = $1 AND tenant_id = $2",
                    session_id,
                    ctx["tenant_id"],
                )

                if not session:
                    raise HTTPException(status_code=404, detail="Session not found")

                if session["status"] != "in_progress":
                    raise HTTPException(
                        status_code=400, detail="Can only match in in-progress sessions"
                    )

                # Verify statement line
                statement_line = await conn.fetchrow(
                    "SELECT id, amount, CASE WHEN type = 'credit' THEN true ELSE false END as is_credit, match_status FROM bank_statement_lines_v2 WHERE id = $1 AND session_id = $2 FOR UPDATE",
                    UUID(body.statement_line_id),
                    session_id,
                )

                if not statement_line:
                    raise HTTPException(status_code=404, detail="Statement line not found")

                if statement_line["match_status"] == "matched":
                    raise HTTPException(
                        status_code=400, detail="Statement line is already matched"
                    )

                # Verify transactions
                tx_ids = [UUID(tx_id) for tx_id in body.transaction_ids]
                transactions = await conn.fetch(
                    """
                    SELECT id, amount, CASE WHEN amount >= 0 THEN true ELSE false END as is_credit, is_cleared
                    FROM bank_transactions
                    WHERE id = ANY($1) AND bank_account_id = $2 AND tenant_id = $3
                    """,
                    tx_ids,
                    session["account_id"],
                    ctx["tenant_id"],
                )

                if len(transactions) != len(tx_ids):
                    raise HTTPException(
                        status_code=404, detail="One or more transactions not found"
                    )

                # Check no transaction is already cleared
                for tx in transactions:
                    if tx["is_cleared"]:
                        raise HTTPException(
                            status_code=400,
                            detail=f"Transaction {tx['id']} is already matched",
                        )

                # Validate amount and type match
                line_amount = statement_line["amount"]
                line_is_credit = statement_line["is_credit"]
                total_tx_amount = sum(tx["amount"] for tx in transactions)

                # For proper matching, types should be compatible
                # Credits in statement = receipts/income, Debits = payments/expenses

                # Determine match type
                if len(tx_ids) == 1:
                    match_type = "one_to_one"
                else:
                    match_type = "one_to_many"

                # Create match record - one row per transaction_id
                for txn_id in tx_ids:
                    match_id = uuid.uuid4()
                    await conn.execute(
                        """
                        INSERT INTO reconciliation_matches (
                            id, tenant_id, session_id, statement_line_id, transaction_id,
                            match_type, confidence, created_by, created_at
                        ) VALUES ($1, $2, $3, $4, $5, $6, 'manual', $7, NOW())
                        """,
                        match_id,
                        ctx["tenant_id"],
                        session_id,
                        UUID(body.statement_line_id),
                        txn_id,
                        match_type,
                        ctx["user_id"],
                    )

                # Update transactions
                now = datetime.utcnow()
                for tx_id in tx_ids:
                    await conn.execute(
                        """
                        UPDATE bank_transactions
                        SET is_cleared = true,
                            cleared_at = $2,
                            matched_statement_line_id = $3
                        WHERE id = $1
                        """,
                        tx_id,
                        now,
                        UUID(body.statement_line_id),
                    )

                # Update statement line status
                await conn.execute(
                    """
                    UPDATE bank_statement_lines_v2
                    SET match_status = 'matched'
                    WHERE id = $1
                    """,
                    UUID(body.statement_line_id),
                )

                # Update session stats
                await update_reconciliation_session_stats(conn, session_id)

                # Get updated stats
                stats = await get_session_statistics(conn, session_id)

                # Record match history for learning loop
                for tx_id in tx_ids:
                    await record_match_history(
                        conn=conn,
                        tenant_id=ctx["tenant_id"],
                        session_id=session_id,
                        statement_line_id=UUID(body.statement_line_id),
                        transaction_id=tx_id,
                        match_confidence="manual",
                        match_method="manual",
                        user_id=ctx["user_id"],
                    )

                # --- Adjustment journal (if difference exists) ---
                adjustment_journal_id = None
                if (
                    body.adjustment_amount is not None
                    and body.adjustment_amount != 0
                    and body.adjustment_account_id is not None
                ):
                    stmt_line_type = body.statement_line_type
                    if not stmt_line_type:
                        # Derive from the statement line if not provided
                        stmt_line_type = "credit" if statement_line["is_credit"] else "debit"

                    # Get bank CoA account ID from the session's bank account
                    bank_account = await conn.fetchrow(
                        "SELECT coa_id FROM bank_accounts WHERE id = $1 AND tenant_id = $2",
                        session["account_id"],
                        ctx["tenant_id"],
                    )
                    if not bank_account:
                        raise HTTPException(status_code=404, detail="Bank account not found")

                    bank_coa_id = str(bank_account["coa_id"])

                    # Compute journal lines using direction logic
                    journal_lines_data = compute_adjustment_journal_lines(
                        difference=body.adjustment_amount,
                        statement_line_type=stmt_line_type,
                        adjustment_account_id=body.adjustment_account_id,
                        bank_coa_id=bank_coa_id,
                    )

                    abs_amount = abs(body.adjustment_amount)

                    # Get the statement line date for posting
                    stmt_date_row = await conn.fetchrow(
                        "SELECT date FROM bank_statement_lines_v2 WHERE id = $1",
                        UUID(body.statement_line_id),
                    )
                    posting_date = stmt_date_row["date"] if stmt_date_row else datetime.utcnow().date()

                    # Generate journal number
                    journal_number = f"RECON-MATCH-ADJ-{posting_date.strftime('%Y%m%d')}-{str(match_id)[:8].upper()}"

                    # Create journal entry (Law 4: Double-entry, Law 23: Atomic)
                    adjustment_journal_id = uuid.uuid4()
                    await conn.execute(
                        """
                        INSERT INTO journal_entries (
                            id, tenant_id, journal_number, journal_date, description,
                            source_type, source_id, status, total_debit, total_credit,
                            created_by, created_at, updated_at
                        ) VALUES ($1, $2, $3, $4, $5, $6, $7, 'POSTED', $8, $8, $9, NOW(), NOW())
                        """,
                        adjustment_journal_id,
                        ctx["tenant_id"],
                        journal_number,
                        posting_date,
                        f"Penyesuaian rekonsiliasi: selisih Rp {abs_amount:,.0f}",
                        "RECONCILIATION_ADJUSTMENT",
                        UUID(body.statement_line_id),
                        abs_amount,
                        ctx["user_id"],
                    )

                    # Insert journal lines
                    for line_num, jl in enumerate(journal_lines_data, start=1):
                        await conn.execute(
                            """
                            INSERT INTO journal_lines (
                                id, journal_id, line_number, account_id,
                                debit, credit, memo
                            ) VALUES ($1, $2, $3, $4, $5, $6, $7)
                            """,
                            uuid.uuid4(),
                            adjustment_journal_id,
                            line_num,
                            UUID(jl["account_id"]),
                            jl["debit"],
                            jl["credit"],
                            f"Penyesuaian rekonsiliasi: selisih Rp {abs_amount:,.0f}",
                        )

                    logger.info(
                        f"Created adjustment journal {journal_number} for match {match_id}, "
                        f"amount={body.adjustment_amount}, type={stmt_line_type}"
                    )

                    # Iron Law 23: Create bank_transaction for adjustment journal
                    # Determine sign: if bank_coa is debited → inflow (positive), credited → outflow (negative)
                    adj_bank_amount = 0
                    for jl in journal_lines_data:
                        if str(jl["account_id"]) == str(bank_coa_id):
                            adj_bank_amount = int(jl["debit"]) - int(jl["credit"])
                            break
                    if adj_bank_amount != 0:
                        await create_bank_transaction_for_journal(
                            conn,
                            tenant_id=ctx["tenant_id"],
                            bank_account_id=session["account_id"],
                            journal_id=adjustment_journal_id,
                            transaction_date=posting_date,
                            transaction_type="adjustment",
                            amount=adj_bank_amount,
                            reference_type="reconciliation_adjustment",
                            reference_id=UUID(body.statement_line_id),
                            description=f"Penyesuaian rekonsiliasi: selisih Rp {abs_amount:,.0f}",
                            created_by=ctx["user_id"],
                        )

                return MatchResponse(
                    match_id=str(match_id),
                    match_type=match_type,
                    confidence="manual",
                    cleared_amount=line_amount,
                    session_stats=stats,
                    adjustment_journal_id=str(adjustment_journal_id) if adjustment_journal_id else None,
                )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error creating match: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to create match")


@router.delete(
    "/sessions/{session_id}/match/{match_id}", response_model=UnmatchResponse
)
async def remove_match(
    request: Request,
    session_id: UUID,
    match_id: UUID,
):
    """Remove a match and reset transaction cleared status."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Verify session
            session = await conn.fetchrow(
                "SELECT status FROM reconciliation_sessions WHERE id = $1 AND tenant_id = $2",
                session_id,
                ctx["tenant_id"],
            )

            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            if session["status"] != "in_progress":
                raise HTTPException(
                    status_code=400, detail="Can only unmatch in in-progress sessions"
                )

            # Get match
            match = await conn.fetchrow(
                "SELECT statement_line_id FROM reconciliation_matches WHERE id = $1 AND session_id = $2",
                match_id,
                session_id,
            )

            if not match:
                raise HTTPException(status_code=404, detail="Match not found")

            # Reset transactions
            await conn.execute(
                """
                UPDATE bank_transactions
                SET is_cleared = false,
                    cleared_at = NULL,
                    matched_statement_line_id = NULL
                WHERE matched_statement_line_id = $1 AND tenant_id = $2
                """,
                match["statement_line_id"],
                ctx["tenant_id"],
            )

            # Reset statement line
            await conn.execute(
                """
                UPDATE bank_statement_lines_v2
                SET match_status = 'unmatched'
                WHERE id = $1
                """,
                match["statement_line_id"],
            )

            # Delete match
            await conn.execute(
                "DELETE FROM reconciliation_matches WHERE id = $1", match_id
            )

            # Update session stats
            await update_reconciliation_session_stats(conn, session_id)

            # Get updated stats
            stats = await get_session_statistics(conn, session_id)

            return UnmatchResponse(success=True, session_stats=stats)

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error removing match: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to remove match")




