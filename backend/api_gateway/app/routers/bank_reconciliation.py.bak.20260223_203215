@router.post("/bank-rules/from-match", response_model=CreateRuleFromMatchResponse)
async def create_rule_from_match(
    request: Request,
    body: CreateRuleFromMatchRequest,
):
    """Auto-create a bank matching rule from a confirmed match pattern."""
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Fetch statement line details
            stmt = await conn.fetchrow(
                """SELECT description, amount, reference, type
                   FROM bank_statement_lines_v2 WHERE id = $1""",
                UUID(body.statement_line_id),
            )
            if not stmt:
                raise HTTPException(status_code=404, detail="Statement line not found")

            # Fetch transaction details
            txn = await conn.fetchrow(
                """SELECT description, amount, source_type, contact_name,
                          contact_id, account_id
                   FROM bank_transactions WHERE id = $1""",
                UUID(body.transaction_id),
            )
            if not txn:
                raise HTTPException(status_code=404, detail="Transaction not found")

            # Build rule conditions from the match pattern
            conditions = []
            stmt_desc = stmt["description"] or ""

            # Condition 1: Description contains key words
            # Extract most significant words (>3 chars, not common noise)
            normalized = normalize_bank_text(stmt_desc)
            words = [w for w in normalized.split() if len(w) > 3]
            if words:
                # Use the longest/most specific word as contains condition
                keyword = max(words, key=len)
                conditions.append({
                    "field": "description",
                    "operator": "contains",
                    "value": keyword,
                    "value2": None,
                })

            # Condition 2: Amount if exact
            if stmt["amount"] == txn["amount"]:
                conditions.append({
                    "field": "amount",
                    "operator": "equals",
                    "value": str(float(stmt["amount"])),
                    "value2": None,
                })

            if not conditions:
                return CreateRuleFromMatchResponse(
                    success=False,
                    message="Tidak bisa membuat rule — deskripsi terlalu umum",
                )

            # Determine direction from statement type
            direction = "both"
            if stmt["type"] == "credit":
                direction = "inflow"
            elif stmt["type"] == "debit":
                direction = "outflow"

            # Auto-generate rule name
            rule_name = body.rule_name or f"Auto: {stmt_desc[:50]}"

            # Get next sort_order
            max_order = await conn.fetchval(
                "SELECT COALESCE(MAX(sort_order), -1) + 1 FROM bank_matching_rules WHERE tenant_id = $1",
                ctx["tenant_id"],
            )

            rule_id = uuid.uuid4()
            conditions_json = json.dumps(conditions)

            await conn.execute(
                """
                INSERT INTO bank_matching_rules (
                    id, tenant_id, name, description, sort_order, rule_type, direction,
                    condition_logic, conditions,
                    contact_id, account_id,
                    created_by
                ) VALUES ($1, $2, $3, $4, $5, 'learned', $6, 'ALL', $7::jsonb, $8, $9, $10)
                """,
                rule_id,
                ctx["tenant_id"],
                rule_name,
                f"Auto-created dari match: {stmt_desc[:80]}",
                max_order,
                direction,
                conditions_json,
                txn["contact_id"],
                txn["account_id"],
                ctx["user_id"],
            )

            # Update match_history to link to rule
            await conn.execute(
                """
                UPDATE match_history
                SET created_rule_id = $1
                WHERE tenant_id = $2 AND statement_description = $3
                ORDER BY created_at DESC
                LIMIT 1
                """,
                rule_id,
                ctx["tenant_id"],
                stmt_desc,
            )

            # Fetch created rule for response
            row = await conn.fetchrow(
                """
                SELECT id, name, description, is_active, sort_order, rule_type,
                       bank_account_id, direction, condition_logic, conditions,
                       contact_id, account_id, tax_rate_id,
                       times_applied, times_confirmed, times_rejected,
                       last_applied_at, created_at
                FROM bank_matching_rules WHERE id = $1
                """,
                rule_id,
            )

            conds = row["conditions"] or []
            if isinstance(conds, str):
                conds = json.loads(conds)

            rule_item = BankRuleItem(
                id=str(row["id"]),
                name=row["name"],
                description=row["description"],
                is_active=row["is_active"],
                sort_order=row["sort_order"],
                rule_type=row["rule_type"],
                bank_account_id=str(row["bank_account_id"]) if row["bank_account_id"] else None,
                direction=row["direction"],
                condition_logic=row["condition_logic"],
                conditions=[
                    RuleConditionSchema(
                        field=c.get("field", ""),
                        operator=c.get("operator", ""),
                        value=str(c.get("value", "")),
                        value2=str(c.get("value2", "")) if c.get("value2") else None,
                    )
                    for c in conds
                ],
                contact_id=str(row["contact_id"]) if row["contact_id"] else None,
                account_id=str(row["account_id"]) if row["account_id"] else None,
                tax_rate_id=str(row["tax_rate_id"]) if row["tax_rate_id"] else None,
                times_applied=row["times_applied"],
                times_confirmed=row["times_confirmed"],
                times_rejected=row["times_rejected"],
                last_applied_at=str(row["last_applied_at"]) if row["last_applied_at"] else None,
                created_at=str(row["created_at"]),
            )

            return CreateRuleFromMatchResponse(
                success=True,
                rule=rule_item,
                message=f"Rule '{rule_name}' berhasil dibuat",
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error creating rule from match: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to create rule from match")



