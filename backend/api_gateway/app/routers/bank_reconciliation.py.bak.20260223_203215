        # Normalize description
        normalized_desc = normalize_bank_text(stmt["description"] or "")

        await conn.execute(
            """
            INSERT INTO match_history (
                tenant_id, session_id,
                statement_description, statement_description_normalized,
                statement_amount, statement_reference, statement_type,
                transaction_description, transaction_amount,
