            """SELECT description, amount, reference, type
               FROM bank_statement_lines_v2 WHERE id = $1""",
            statement_line_id,
        )
        if not stmt:
            return

        # Fetch transaction details
        txn = await conn.fetchrow(
            """SELECT description, amount, reference_type, reference_number,
                      payee_payer, bank_account_id
               FROM bank_transactions WHERE id = $1""",
            transaction_id,
        )
        if not txn:
