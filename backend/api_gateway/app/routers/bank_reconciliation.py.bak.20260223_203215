            stmt["description"],
            normalized_desc,
            stmt["amount"],
            stmt["reference"],
            stmt["type"],
            txn["description"],
            txn["amount"],
            txn["reference_type"],
            txn["reference_number"],
            txn["payee_payer"],
            None,  # contact_id not available in bank_transactions
            txn["bank_account_id"],
            match_confidence,
            match_method,
            user_id,
        )
    except Exception as e:
        # Non-critical — don't fail the match if history recording fails
        logger.warning(f"Failed to record match history: {e}")


