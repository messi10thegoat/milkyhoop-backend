@router.post("/sessions/{session_id}/clear-transactions")
async def clear_transactions(
    request: Request,
    session_id: UUID,
    body: ClearTransactionsRequest,
):
    """
    Set which transactions are cleared in a manual reconciliation session.
    Uses SERIALIZABLE isolation and diff-based updates (Law 13, 23).
    Only changes what changed — no full wipe-and-rewrite.
    """
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            async with conn.transaction(isolation="serializable"):
                # 1. Lock session FOR UPDATE
                session = await conn.fetchrow(
                    """
                    SELECT id, status, account_id, statement_ending_balance, opening_balance, mode
                    FROM reconciliation_sessions
                    WHERE id = $1 AND tenant_id = $2
                    FOR UPDATE
                    """,
                    session_id,
                    ctx["tenant_id"],
                )

                if not session:
                    raise HTTPException(status_code=404, detail="Session not found")

                if session["status"] != "in_progress":
                    raise HTTPException(
                        status_code=409, detail="Session sudah selesai"
                    )

                # 2. Diff-based: only change what changed
                currently_cleared_rows = await conn.fetch(
                    """
                    SELECT id FROM bank_transactions
                    WHERE reconciled_session_id = $1 AND tenant_id = $2
                    """,
                    session_id,
                    ctx["tenant_id"],
                )
                currently_cleared = set(str(r["id"]) for r in currently_cleared_rows)
                new_cleared = set(body.transaction_ids)

                to_clear = new_cleared - currently_cleared
                to_unclear = currently_cleared - new_cleared

                now = datetime.utcnow()

                # 3. Batch update only diffs
                if to_clear:
                    to_clear_uuids = [UUID(tid) for tid in to_clear]
                    await conn.execute(
                        """
                        UPDATE bank_transactions
                        SET is_cleared = true,
                            cleared_at = $2,
                            reconciled_session_id = $1
                        WHERE id = ANY($3) AND tenant_id = $4
                        """,
                        session_id,
                        now,
                        to_clear_uuids,
                        ctx["tenant_id"],
                    )

                if to_unclear:
                    to_unclear_uuids = [UUID(tid) for tid in to_unclear]
                    await conn.execute(
                        """
                        UPDATE bank_transactions
                        SET is_cleared = false,
                            cleared_at = NULL,
                            reconciled_session_id = NULL
                        WHERE id = ANY($1) AND tenant_id = $2
                        """,
                        to_unclear_uuids,
                        ctx["tenant_id"],
                    )

                # 4. Compute balance proof
                stats = await conn.fetchrow(
                    """
                    SELECT
                        COALESCE(SUM(CASE WHEN amount >= 0 THEN amount ELSE 0 END), 0) AS cleared_inflows,
                        COALESCE(SUM(CASE WHEN amount < 0 THEN ABS(amount) ELSE 0 END), 0) AS cleared_outflows,
                        COUNT(*) AS cleared_count
                    FROM bank_transactions
                    WHERE reconciled_session_id = $1 AND tenant_id = $2
                    """,
                    session_id,
                    ctx["tenant_id"],
                )

                opening = int(session["opening_balance"] or 0)
                cleared_inflows = int(stats["cleared_inflows"])
                cleared_outflows = int(stats["cleared_outflows"])
                cleared_balance = opening + cleared_inflows - cleared_outflows
                statement_ending = int(session["statement_ending_balance"])
                difference = statement_ending - cleared_balance

                # 5. Update session stats
                await conn.execute(
                    """
                    UPDATE reconciliation_sessions
                    SET cleared_balance = $2,
                        difference = $3,
                        cleared_count = $4,
                        updated_at = $5
                    WHERE id = $1
                    """,
                    session_id,
                    cleared_balance,
                    difference,
                    int(stats["cleared_count"]),
                    now,
                )

                return {
                    "success": True,
                    "cleared_count": int(stats["cleared_count"]),
                    "cleared_inflows": cleared_inflows,
                    "cleared_outflows": cleared_outflows,
                    "cleared_balance": cleared_balance,
                    "statement_ending_balance": statement_ending,
                    "difference": difference,
                }

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error clearing transactions: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to clear transactions")


@router.post("/sessions/{session_id}/manual-complete")
async def manual_complete_session(
    request: Request,
    session_id: UUID,
):
    """
    Complete a manual reconciliation session when difference = 0.
    No adjustment needed.
    """
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            async with conn.transaction(isolation="serializable"):
                session = await conn.fetchrow(
                    """
                    SELECT id, status, account_id, statement_ending_balance,
                           opening_balance, mode
                    FROM reconciliation_sessions
                    WHERE id = $1 AND tenant_id = $2
                    FOR UPDATE
                    """,
                    session_id,
                    ctx["tenant_id"],
                )

                if not session:
                    raise HTTPException(status_code=404, detail="Session not found")

                if session["status"] != "in_progress":
                    raise HTTPException(
                        status_code=409, detail="Session sudah selesai"
                    )

                # Compute cleared balance
                opening = int(session["opening_balance"] or 0)
                stats = await conn.fetchrow(
                    """
                    SELECT
                        COALESCE(SUM(CASE WHEN amount >= 0 THEN amount ELSE 0 END), 0) AS inflows,
                        COALESCE(SUM(CASE WHEN amount < 0 THEN ABS(amount) ELSE 0 END), 0) AS outflows,
                        COUNT(*) AS cnt
                    FROM bank_transactions
                    WHERE reconciled_session_id = $1 AND tenant_id = $2
                    """,
                    session_id,
                    ctx["tenant_id"],
                )

                cleared_balance = opening + int(stats["inflows"]) - int(stats["outflows"])
                statement_ending = int(session["statement_ending_balance"])
                difference = statement_ending - cleared_balance

                if difference != 0:
                    raise HTTPException(
                        status_code=400,
                        detail=f"Selisih belum 0 (Rp {difference:,}). Gunakan penyesuaian.",
                    )

                now = datetime.utcnow()

                # Mark cleared transactions as reconciled
                await conn.execute(
                    """
                    UPDATE bank_transactions
                    SET is_reconciled = true,
                        reconciled_at = $2
                    WHERE reconciled_session_id = $1 AND tenant_id = $3
                    """,
                    session_id,
                    now,
                    ctx["tenant_id"],
                )

                # Complete session
                await conn.execute(
                    """
                    UPDATE reconciliation_sessions
                    SET status = 'completed',
                        completed_at = $2,
                        difference = 0,
                        cleared_balance = $3,
                        updated_at = $2
                    WHERE id = $1
                    """,
                    session_id,
                    now,
                    cleared_balance,
                )

                return {
                    "success": True,
                    "session_id": str(session_id),
                    "status": "completed",
                    "cleared_count": int(stats["cnt"]),
                    "statement_ending_balance": statement_ending,
                    "cleared_balance": cleared_balance,
                }

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error completing manual session: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to complete session")


@router.post("/sessions/{session_id}/manual-adjustment")
async def manual_adjustment(
    request: Request,
    session_id: UUID,
    body: ManualAdjustmentRequest,
):
    """
    Create an adjustment journal to close a manual reconciliation session.
    Full Iron Laws compliance: 4 (double-entry), 6 (source traceability),
    14 (idempotency), 17 (currency snapshot), 23 (atomicity).

    After creating the journal, the session is marked completed.
    """
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Law 14: Idempotency check
            idempotency_key = f"recon-adj-{session_id}"
            existing = await conn.fetchrow(
                """
                SELECT result FROM idempotency_keys
                WHERE key = $1 AND tenant_id = $2 AND expires_at > NOW()
                """,
                idempotency_key,
                ctx["tenant_id"],
            )
            if existing and existing["result"]:
                import json
                return json.loads(existing["result"])

            async with conn.transaction(isolation="serializable"):
                # Lock session
                session = await conn.fetchrow(
                    """
                    SELECT id, status, account_id, statement_ending_balance,
                           opening_balance, mode
                    FROM reconciliation_sessions
                    WHERE id = $1 AND tenant_id = $2
                    FOR UPDATE
                    """,
                    session_id,
                    ctx["tenant_id"],
                )

                if not session:
                    raise HTTPException(status_code=404, detail="Session not found")

                if session["status"] != "in_progress":
                    raise HTTPException(
                        status_code=409, detail="Session sudah selesai"
                    )


                # Advisory lock (Bank Sync Rule 4)
                await conn.execute(
                    "SELECT pg_advisory_xact_lock(hashtext($1))",
                    f"BANK_TX:recon-adj:{session_id}:{session['account_id']}",
                )
                # Get bank account COA
                bank_account = await conn.fetchrow(
                    "SELECT coa_id, name FROM bank_accounts WHERE id = $1 AND tenant_id = $2",
                    session["account_id"],
                    ctx["tenant_id"],
                )

                if not bank_account or not bank_account["coa_id"]:
                    raise HTTPException(
                        status_code=400,
                        detail="Bank account has no linked COA account",
                    )

                # Determine adjustment account
                adj_account_id = None
                if body.adjustment_account_id:
                    adj_account_id = UUID(body.adjustment_account_id)
                else:
                    # Default: find misc expense account
                    adj_account_id = await conn.fetchval(
                        """
                        SELECT id FROM chart_of_accounts
                        WHERE tenant_id = $1 AND (
                            code LIKE '%%9%%' OR name ILIKE '%%lain%%' OR name ILIKE '%%misc%%'
                        )
                        AND type = 'EXPENSE'
                        ORDER BY code
                        LIMIT 1
                        """,
                        ctx["tenant_id"],
                    )
                    if not adj_account_id:
                        # Fallback: any expense account
                        adj_account_id = await conn.fetchval(
                            """
                            SELECT id FROM chart_of_accounts
                            WHERE tenant_id = $1 AND type = 'EXPENSE'
                            ORDER BY code
                            LIMIT 1
                            """,
                            ctx["tenant_id"],
                        )

                if not adj_account_id and not body.adjustment_lines:
                    raise HTTPException(
                        status_code=400,
                        detail="No adjustment account found. Please specify one.",
                    )

                now = datetime.utcnow()
                amount = abs(body.amount)

                # ---- Multi-line adjustment support ----
                # Backward compat: wrap single account_id into adjustment_lines
                if not body.adjustment_lines and adj_account_id:
                    body.adjustment_lines = [
                        AdjustmentLineItem(account_id=str(adj_account_id), amount=amount)
                    ]

                if body.adjustment_lines:
                    # Validate sum equals difference
                    line_total = sum(line.amount for line in body.adjustment_lines)
                    if line_total != amount:
                        raise HTTPException(
                            status_code=422,
                            detail=f"Sum of adjustment lines ({line_total}) does not equal difference ({amount})"
                        )

                    # Validate no duplicates
                    account_ids = [line.account_id for line in body.adjustment_lines]
                    if len(account_ids) != len(set(account_ids)):
                        raise HTTPException(
                            status_code=422,
                            detail="Duplicate account IDs in adjustment lines"
                        )

                    # Validate all amounts positive
                    if any(line.amount <= 0 for line in body.adjustment_lines):
                        raise HTTPException(
                            status_code=422,
                            detail="All line amounts must be positive"
                        )

                # Law 6: Source traceability
                source_type = "RECONCILIATION_ADJUSTMENT"
                source_id = str(session_id)

                # Law 17: Currency snapshot (IDR, rate 1.0)
                currency_code = "IDR"
                exchange_rate = 1.0

                # Generate journal number
                journal_number = f"RECON-ADJ-{now.strftime('%Y%m%d')}-{str(session_id)[:8].upper()}"

                # Law 4: Double-entry journal creation
                journal_id = uuid.uuid4()
                await conn.execute(
                    """
                    INSERT INTO journal_entries (
                        id, tenant_id, entry_date, reference, description,
                        source_type, source_id, status, total_debit, total_credit,
                        created_by, created_at, updated_at
                    ) VALUES ($1, $2, $3, $4, $5, $6, $7, 'POSTED', $8, $8, $9, $10, $10)
                    """,
                    journal_id,
                    ctx["tenant_id"],
                    now.date(),
                    journal_number,
                    f"Penyesuaian Rekonsiliasi: {body.description}",
                    source_type,
                    source_id,
                    amount,
                    ctx["user_id"],
                    now,
                )

                # Journal lines — N+1 multi-line support
                # If body.amount > 0 (bank > book): DEBIT bank for total, CREDIT each contra
                # If body.amount < 0 (book > bank): DEBIT each contra, CREDIT bank for total
                line_number = 1

                if body.amount > 0:
                    # Bank has more: Debit Bank (one line), Credit each contra account
                    await conn.execute(
                        """
                        INSERT INTO journal_lines (
                            id, journal_id, line_number, account_id,
                            debit, credit, memo
                        ) VALUES ($1, $2, $3, $4, $5, 0, $6)
                        """,
                        uuid.uuid4(),
                        journal_id,
                        line_number,
                        bank_account["coa_id"],
                        amount,
                        body.description,
                    )
                    line_number += 1

                    for adj_line in body.adjustment_lines:
                        await conn.execute(
                            """
                            INSERT INTO journal_lines (
                                id, journal_id, line_number, account_id,
                                debit, credit, memo
                            ) VALUES ($1, $2, $3, $4, 0, $5, $6)
                            """,
                            uuid.uuid4(),
                            journal_id,
                            line_number,
                            UUID(adj_line.account_id),
                            adj_line.amount,
                            body.description,
                        )
                        line_number += 1
                else:
                    # Bank has less: Debit each contra account, Credit Bank (one line)
                    for adj_line in body.adjustment_lines:
                        await conn.execute(
                            """
                            INSERT INTO journal_lines (
                                id, journal_id, line_number, account_id,
                                debit, credit, memo
                            ) VALUES ($1, $2, $3, $4, $5, 0, $6)
                            """,
                            uuid.uuid4(),
                            journal_id,
                            line_number,
                            UUID(adj_line.account_id),
                            adj_line.amount,
                            body.description,
                        )
                        line_number += 1

                    await conn.execute(
                        """
                        INSERT INTO journal_lines (
                            id, journal_id, line_number, account_id,
                            debit, credit, memo
                        ) VALUES ($1, $2, $3, $4, 0, $5, $6)
                        """,
                        uuid.uuid4(),
                        journal_id,
                        line_number,
                        bank_account["coa_id"],
                        amount,
                        body.description,
                    )

                # Iron Law 23: Create bank_transaction for manual adjustment
                adj_bank_amount_signed = body.amount  # positive = bank has more = inflow
                adj_tx_id = await create_bank_transaction_for_journal(
                    conn,
                    tenant_id=ctx["tenant_id"],
                    bank_account_id=session["account_id"],
                    journal_id=journal_id,
                    transaction_date=now.date(),
                    transaction_type="adjustment",
                    amount=int(adj_bank_amount_signed),
                    reference_type="reconciliation_adjustment",
                    reference_id=session_id,
                    description=f"Penyesuaian Rekonsiliasi: {body.description}",
                    created_by=ctx["user_id"],
                )

                # Link adjustment bank_txn to session so bulk UPDATE includes it
                await conn.execute(
                    """UPDATE bank_transactions
                       SET reconciled_session_id = $1, is_cleared = true, cleared_at = $2
                       WHERE id = $3""",
                    session_id, now, adj_tx_id,
                )

                # Law 23: Atomic — complete session in same transaction
                # Mark cleared transactions as reconciled
                await conn.execute(
                    """
                    UPDATE bank_transactions
                    SET is_reconciled = true,
                        reconciled_at = $2
                    WHERE reconciled_session_id = $1 AND tenant_id = $3
                    """,
                    session_id,
                    now,
                    ctx["tenant_id"],
                )

                await conn.execute(
                    """
                    UPDATE reconciliation_sessions
                    SET status = 'completed',
                        completed_at = $2,
                        difference = 0,
                        updated_at = $2
                    WHERE id = $1
                    """,
                    session_id,
                    now,
                )

                response_data = {
                    "success": True,
                    "journal_id": str(journal_id),
                    "journal_number": journal_number,
                    "amount": body.amount,
                    "session_completed": True,
                }

                # Store idempotency result (Law 14)
                try:
                    import json
                    await conn.execute(
                        """
                        INSERT INTO idempotency_keys (key, tenant_id, result, created_at, expires_at)
                        VALUES ($1, $2, $3, NOW(), NOW() + INTERVAL '24 hours')
                        ON CONFLICT (key, tenant_id) DO NOTHING
                        """,
                        idempotency_key,
                        ctx["tenant_id"],
                        json.dumps(response_data),
                    )
                except Exception:
                    pass  # Idempotency storage failure is non-fatal

                return response_data

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error creating manual adjustment: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to create adjustment")


@router.post("/sessions/{session_id}/complete", response_model=CompleteResponse)
async def complete_session(
    request: Request,
    session_id: UUID,
    body: CompleteSessionRequest,
):
    """
    Complete a reconciliation session.

    Validates that the difference is zero (or covered by adjustments),
    creates journal entries for adjustments, marks transactions as reconciled,
    and updates session status to completed.
    """
    try:
        ctx = get_user_context(request)
        pool = await get_pool()

        async with pool.acquire() as conn:
            await conn.execute(f"SET app.tenant_id = '{ctx['tenant_id']}'")

            # Verify session
            session = await conn.fetchrow(
                """
                SELECT id, status, account_id, statement_beginning_balance,
                       statement_ending_balance, cleared_balance, difference
                FROM reconciliation_sessions
                WHERE id = $1 AND tenant_id = $2
                """,
                session_id,
                ctx["tenant_id"],
            )

            if not session:
                raise HTTPException(status_code=404, detail="Session not found")

            if session["status"] != "in_progress":
                raise HTTPException(
                    status_code=400, detail="Can only complete in-progress sessions"
                )

            # Calculate adjustments total
            adjustments_total = sum(adj.amount for adj in body.adjustments)
            current_difference = session["difference"] or 0
            final_difference = current_difference - adjustments_total

            # Validate difference is covered
            if final_difference != 0 and len(body.adjustments) == 0:
                raise HTTPException(
                    status_code=400,
                    detail=f"Cannot complete session with difference of {final_difference}. Add adjustments to balance.",
                )

            if abs(final_difference) > 100:  # Allow small rounding differences
                raise HTTPException(
                    status_code=400,
                    detail=f"Remaining difference of {final_difference} is too large. Add more adjustments.",
                )

            now = datetime.utcnow()
            journal_entries_created = 0

            # Get bank account COA entry
            bank_account = await conn.fetchrow(
                "SELECT coa_id FROM bank_accounts WHERE id = $1", session["account_id"]
            )

            # Create adjustments and journal entries
            for adj in body.adjustments:
                adj_id = uuid.uuid4()
                await conn.execute(
                    """
                    INSERT INTO reconciliation_adjustments (
                        id, tenant_id, session_id, type, amount, description,
                        account_id, created_by, created_at
                    ) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
                    """,
                    adj_id,
                    ctx["tenant_id"],
                    session_id,
                    adj.type,
                    adj.amount,
                    adj.description,
                    UUID(adj.account_id),
                    ctx["user_id"],
                    now,
                )

                # Create journal entry for adjustment
                journal_id = uuid.uuid4()
                await conn.execute(
                    """
                    INSERT INTO journal_entries (
                        id, tenant_id, entry_date, reference, description,
                        source_type, source_id, status, created_by, created_at, updated_at
                    ) VALUES ($1, $2, $3, $4, $5, 'reconciliation', $6, 'posted', $7, $8, $8)
                    """,
                    journal_id,
                    ctx["tenant_id"],
                    now.date(),
                    f"RECON-ADJ-{session_id.hex[:8]}",
                    f"Bank Reconciliation Adjustment: {adj.description}",
                    session_id,
                    ctx["user_id"],
                    now,
                )

                line_num = 0

                # Create journal entry lines
                # Debit/Credit depends on adjustment type
                if adj.type in ["bank_fee", "correction"]:
                    # Fee: Debit expense, Credit bank
                    line_num += 1
                    await conn.execute(
                        """
                        INSERT INTO journal_lines (
                            id, journal_id, line_number, account_id, debit, credit, memo
                        ) VALUES ($1, $2, $3, $4, $5, 0, $6)
                        """,
                        uuid.uuid4(),
                        journal_id,
                        line_num,
                        UUID(adj.account_id),
                        adj.amount,
                        adj.description,
                    )
                    if bank_account and bank_account["coa_id"]:
                        line_num += 1
                        await conn.execute(
                            """
                            INSERT INTO journal_lines (
                                id, journal_id, line_number, account_id, debit, credit, memo
                            ) VALUES ($1, $2, $3, $4, 0, $5, $6)
                            """,
                            uuid.uuid4(),
                            journal_id,
                            line_num,
                            bank_account["coa_id"],
                            adj.amount,
                            adj.description,
                        )
                elif adj.type == "interest":
                    # Interest: Debit bank, Credit income
                    if bank_account and bank_account["coa_id"]:
                        line_num += 1
                        await conn.execute(
                            """
                            INSERT INTO journal_lines (
                                id, journal_id, line_number, account_id, debit, credit, memo
                            ) VALUES ($1, $2, $3, $4, $5, 0, $6)
                            """,
                            uuid.uuid4(),
                            journal_id,
                            line_num,
                            bank_account["coa_id"],
                            adj.amount,
                            adj.description,
                        )
                    line_num += 1
                    await conn.execute(
                        """
                        INSERT INTO journal_lines (
                            id, journal_id, line_number, account_id, debit, credit, memo
                        ) VALUES ($1, $2, $3, $4, 0, $5, $6)
                        """,
                        uuid.uuid4(),
                        journal_id,
                        line_num,
                        UUID(adj.account_id),
                        adj.amount,
                        adj.description,
                    )
                else:
                    # Other: Default to debit expense, credit bank
                    line_num += 1
                    await conn.execute(
                        """
                        INSERT INTO journal_lines (
                            id, journal_id, line_number, account_id, debit, credit, memo
                        ) VALUES ($1, $2, $3, $4, $5, 0, $6)
                        """,
                        uuid.uuid4(),
                        journal_id,
                        line_num,
                        UUID(adj.account_id),
                        adj.amount,
                        adj.description,
                    )
                    if bank_account and bank_account["coa_id"]:
                        line_num += 1
                        await conn.execute(
                            """
                            INSERT INTO journal_lines (
                                id, journal_id, line_number, account_id, debit, credit, memo
                            ) VALUES ($1, $2, $3, $4, 0, $5, $6)
                            """,
                            uuid.uuid4(),
                            journal_id,
                            line_num,
                            bank_account["coa_id"],
                            adj.amount,
                            adj.description,
                        )

                journal_entries_created += 1

            # Mark all matched transactions as reconciled
            await conn.execute(
                """
                UPDATE bank_transactions
                SET is_reconciled = true,
                    reconciled_at = $2,
                    reconciled_session_id = $1
                WHERE tenant_id = $3
                  AND matched_statement_line_id IN (
                      SELECT id FROM bank_statement_lines_v2 WHERE session_id = $1
                  )
                """,
                session_id,
                now,
                ctx["tenant_id"],
            )

            # Get final statistics
            matched_count = await conn.fetchval(
                """
                SELECT COUNT(*) FROM bank_statement_lines_v2
                WHERE session_id = $1 AND match_status = 'matched'
                """,
                session_id,
            )

            # Update session status to completed
            await conn.execute(
                """
                UPDATE reconciliation_sessions
                SET status = 'completed',
                    completed_at = $2,
                    difference = $3,
                    updated_at = $2
                WHERE id = $1
                """,
                session_id,
                now,
                final_difference,
            )

            return CompleteResponse(
                success=True,
                completed_at=now.isoformat(),
                final_stats=FinalStats(
                    total_matched=matched_count or 0,
                    total_adjustments=len(body.adjustments),
                    opening_difference=current_difference,
                    closing_difference=adjustments_total,
                    final_difference=final_difference,
                ),
                journal_entries_created=journal_entries_created,
            )

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error completing session: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail="Failed to complete session")




