"""
Session-aware wrapper for UnifiedAgent

Minimal modification approach for Phase A:
- Wraps existing UnifiedAgent
- Adds 4-layer memory
- Maintains backward compatibility
"""
from typing import Optional, List, Dict
from .orchestrator import UnifiedAgent, AgentResponse, TenantContext
from .session_manager import SessionManager, StateUpdateHooks
from .db_utils import get_session_db_pool

class SessionAwareAgent:
    """Wrapper that adds session management to UnifiedAgent."""
    
    def __init__(self):
        self.agent = UnifiedAgent()
        self.db_pool = None
    
    async def process_message(
        self,
        user_text: str,
        context: TenantContext,
        conversation_history: Optional[List[Dict[str, str]]] = None,
        session_id: Optional[str] = None,
    ) -> Dict:
        """Process message with session management.
        
        Returns AgentResponse with added session_id field.
        """
        import logging
        logger = logging.getLogger(__name__)
        print(f"🔍 [SESSION_ORCH] START process_message, session_id={session_id}")
        # Initialize db pool if needed
        if not self.db_pool:
            self.db_pool = await get_session_db_pool()
        
        # Create session manager
        session_manager = SessionManager(
            db_pool=self.db_pool,
            tenant_id=context.tenant_id,
            user_id=context.user_id
        )
        
        # Get or create session
        session_id = await session_manager.get_or_create_session(session_id)
        
        # Store user message
        await session_manager.store_message(session_id, "user", user_text)
        
        # Get conversation history from session (replaces gRPC history)
        if not conversation_history:
            working_window = await session_manager.get_working_window(session_id, max_turns=6)
            conversation_history = working_window
        
        # === PHASE A: Inject Layer 2 structured state into conversation ===
        # Get structured state and inject as system message
        state = await session_manager.get_state(session_id)
        state_context = state.to_context_string()
        print(f"🔍 [DEBUG] active_items={state.active_items}, state_context={repr(state_context)}")
        
        if state_context:
            # Inject Layer 2 context as first message in conversation history
            # This ensures UnifiedAgent sees active customer/items in context
            enriched_history = [
                {"role": "system", "content": state_context}
            ]
            if conversation_history:
                enriched_history.extend(conversation_history)
            conversation_history = enriched_history
            print(f"🔍 [PHASE A] Injected Layer 2 context: {state_context[:100]}...")
        
        # Call original agent with enriched context
        agent_response = await self.agent.process_message(
            user_text=user_text,
            context=context,
            conversation_history=conversation_history,
        )

        # Normalize response (handle both dict and AgentResponse object)
        if isinstance(agent_response, dict):
            content = agent_response.get("content", "")
            tool_calls_made = agent_response.get("tool_calls_made", [])
            message_type = agent_response.get("message_type", "TEXT")
            pending_action_id = agent_response.get("pending_action_id")
            preview = agent_response.get("preview")
            expires_at = agent_response.get("expires_at")
            errors = agent_response.get("errors")
            iterations = agent_response.get("iterations", 0)
            model_used = agent_response.get("model_used")
            total_latency_ms = agent_response.get("total_latency_ms", 0)
        else:
            content = agent_response.content or ""
            tool_calls_made = agent_response.tool_calls_made or []
            message_type = agent_response.message_type or "TEXT"
            pending_action_id = agent_response.pending_action_id
            preview = agent_response.preview
            expires_at = agent_response.expires_at
            errors = agent_response.errors
            iterations = agent_response.iterations or 0
            model_used = agent_response.model_used
            total_latency_ms = agent_response.total_latency_ms or 0
        
        
        # Store assistant response
        # === PHASE A FIX: Generate content summary for ACTION_PREVIEW ===
        # So it appears in conversation history for next turns
        content_to_store = content or ""
        if message_type == "ACTION_PREVIEW" and preview:
            preview_data = preview if isinstance(preview, dict) else {}
            payload = preview_data.get("payload", {})
            action_type = preview_data.get("action_type", "")
            
            # Generate human-readable summary
            if action_type == "CREATE_SALES_INVOICE":
                cust = payload.get("customer_name", "?")
                items_list = payload.get("items", [])
                if items_list:
                    item_desc = items_list[0].get("description", "?")
                    qty = items_list[0].get("quantity", 0)
                    content_to_store = f"[Usulan faktur untuk {cust}: {item_desc} x {qty} pcs]"
                else:
                    content_to_store = f"[Usulan faktur untuk {cust}]"
            else:
                content_to_store = f"[Usulan {action_type}]"
        
        await session_manager.store_message(
            session_id, 
            "assistant", 
            content_to_store,
            message_type=message_type
        )
        
        # Extract entity IDs from successful search tools
        # For searches, we need to look at the agent's response content
        search_results = {}
        if tool_calls_made:
            for tool_call in tool_calls_made:
                if tool_call.get("success") and tool_call.get("name") in ["search_customers", "search_items", "search_vendors"]:
                    # The agent's TEXT response contains the found entity
                    # Parse from response content (pragmatic Phase A approach)
                    response_text = content or ""
                    
                    # Extract customer from "Ditemukan: [Name]" pattern
                    if tool_call.get("name") == "search_customers":
                        import re
                        match = re.search(r"Ditemukan:\s*([^.]+)", response_text)
                        if match:
                            found_name = match.group(1).strip()
                            # Store for later use (we still need ID though)
                            search_results["customer_name"] = found_name
        
        # PHASE A: Update structured state from tool calls
        # Now tool_calls_made includes "data" field from orchestrator!
        import logging
        logger = logging.getLogger(__name__)
        print(f"🔍 [SESSION_ORCHESTRATOR] Processing {len(tool_calls_made) if tool_calls_made else 0} tool calls")
        
        if tool_calls_made:
            for tool_call in tool_calls_made:
                print(f"🔍 Tool call: {tool_call}")
                tool_name = tool_call.get("name")
                tool_success = tool_call.get("success", False)
                tool_data = tool_call.get("data")  # ← Data from orchestrator!
                
                # Update structured state
                print(f"🔍 Checking: name={tool_name}, success={tool_success}, has_data={tool_data is not None}")
                print(f"🔍 tool_data type: {type(tool_data)}, value: {tool_data}")
                # from search results
                if tool_success and tool_name == "search_customers" and tool_data:
                    print(f"🔍 INSIDE search_customers block!")
                    # Extract customers list from response dict
                    customers = tool_data.get("customers", []) if isinstance(tool_data, dict) else tool_data
                    print(f"🔍 customers list: {customers}")
                    if customers:
                        first = customers[0]
                        print(f"🔍 first customer: {first}")
                        cust_id = first.get("id")
                        cust_name = first.get("name")
                        print(f"🔍 Calling update_state with id={cust_id}, name={cust_name}")
                        await session_manager.update_state(
                            session_id,
                            active_customer_id=cust_id,
                            active_customer_name=cust_name
                        )
                
                elif tool_success and tool_name == "search_items" and tool_data:
                    items = tool_data if isinstance(tool_data, list) else [tool_data]
                    if items:
                        await session_manager.update_state(
                            session_id,
                            active_items=[{
                                "id": item.get("id"),
                                "name": item.get("name"),
                                "sku": item.get("sku")
                            } for item in items[:5]]  # Store up to 5 items
                        )
                
                # Call hooks for propose_action
                elif tool_name == "propose_action":
                    tool_args = tool_call.get("args", {})
                    action_type = tool_args.get("action_type", "")
                    result = {"success": tool_success, "data": tool_data} if tool_success else {"success": False}
                    await StateUpdateHooks.after_propose(
                        session_manager, session_id, action_type, tool_args, result
                    )
        

                # Hook: Update state when propose_action is called
                if tool_success and tool_name == "propose_action" and tool_data:
                    print(f"🔍 INSIDE propose_action hook!")
                    preview = tool_data.get("preview", {}) if isinstance(tool_data, dict) else {}
                    payload = preview.get("payload", {})
                    pending_id = tool_data.get("pending_action_id")
                    action_type = preview.get("action_type", "")
                    
                    # Extract items
                    items_list = payload.get("items", [])
                    if items_list:
                        # Store full item details in Layer 2
                        await session_manager.update_state(
                            session_id,
                            active_items=items_list,
                            pending_action_id=pending_id,
                            last_action_type=action_type,
                            last_action_status="proposed"
                        )
                        print(f"🔍 Stored {len(items_list)} items in Layer 2, pending_action_id={pending_id}")
                
        # Convert to dict with session_id
        return {
            "message_type": message_type,
            "content": content,
            "pending_action_id": pending_action_id,
            "preview": preview,
            "expires_at": expires_at,
            "errors": errors,
            "iterations": iterations,
            "tool_calls_made": tool_calls_made,
            "model_used": model_used,
            "total_latency_ms": total_latency_ms,
            "trace_id": agent_response.trace_id,
            "session_id": session_id,  # NEW
        }
