"""
Arus Kas (Cash Flow Statement) — Metode Langsung (Direct Method). PSAK-compliant.
All data from journal_lines (Law 1).

Logic: Find all journal lines that touch cash accounts (is_cash=TRUE),
then classify by the cash_flow_category of the COUNTERPART account.
Default category = OPERATING (most common for trade activities).
"""
from decimal import Decimal
from datetime import date as date_type, datetime, timedelta
from .ledger import compute_balance, _to_date


async def generate_cash_flow(conn, tenant_id: str, start: str, end: str) -> dict:
    """
    Direct method cash flow statement.
    Groups cash movements by counterpart account's cash_flow_category.
    """
    # Fixed query: avoids N:M join double-counting.
    # Step 1: Net cash per journal (aggregated). Step 2: Dominant counterpart category.
    sql = """
        WITH cash_per_journal AS (
            -- Net cash movement per journal (avoids double-counting)
            SELECT jl.journal_id,
                   COALESCE(SUM(jl.debit), 0) - COALESCE(SUM(jl.credit), 0) AS net_cash
            FROM journal_lines jl
            JOIN journal_entries je ON je.id = jl.journal_id
            JOIN chart_of_accounts coa ON coa.id = jl.account_id
            WHERE je.status = 'POSTED'
              AND je.tenant_id = $1
              AND je.journal_date >= $2
              AND je.journal_date <= $3
              AND coa.is_cash = TRUE
            GROUP BY jl.journal_id
        ),
        dominant_category AS (
            -- For each journal, pick category from the LARGEST counterpart line
            -- This ensures each journal is counted exactly once
            SELECT DISTINCT ON (cpj.journal_id)
                cpj.journal_id,
                cpj.net_cash,
                COALESCE(coa.cash_flow_category, 'OPERATING') AS category
            FROM cash_per_journal cpj
            JOIN journal_lines jl ON jl.journal_id = cpj.journal_id
            JOIN chart_of_accounts coa ON coa.id = jl.account_id
            WHERE coa.is_cash IS NOT TRUE
            ORDER BY cpj.journal_id, ABS(jl.debit - jl.credit) DESC
        )
        SELECT category,
               COALESCE(SUM(net_cash), 0) AS net_flow
        FROM dominant_category
        GROUP BY category
    """
    rows = await conn.fetch(sql, tenant_id, _to_date(start), _to_date(end))
    flows = {r["category"]: Decimal(str(r["net_flow"])) for r in rows}

    # Handle NONE category (should be rare — intra-cash transfers)
    none_flow = flows.pop("NONE", Decimal("0"))

    operating = flows.get("OPERATING", Decimal("0")) + none_flow
    investing = flows.get("INVESTING", Decimal("0"))
    financing = flows.get("FINANCING", Decimal("0"))
    net_change = operating + investing + financing

    # Opening cash = all cash account balances as of day before period start
    day_before = (datetime.strptime(start, "%Y-%m-%d") - timedelta(days=1)).strftime("%Y-%m-%d")
    cash_start = await compute_balance(conn, tenant_id, {"is_cash": True}, end_date=day_before)
    cash_end = await compute_balance(conn, tenant_id, {"is_cash": True}, end_date=end)

    return {
        "period": {"start": start, "end": end},
        "operasi": float(operating),
        "investasi": float(investing),
        "pendanaan": float(financing),
        "kenaikan_kas_bersih": float(net_change),
        "kas_awal": float(cash_start),
        "kas_akhir": float(cash_end),
        "_reconciled": abs(cash_start + net_change - cash_end) < Decimal("0.01"),
    }
