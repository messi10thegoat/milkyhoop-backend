<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><title>Faktur {{ invoice.invoice_number or '-' }}</title></head>
<body>
<div class="invoice">

    <!-- 1. Header -->
    <div class="header">
        <div>
            <h1 class="doc-title">Faktur Penjualan</h1>
            <div class="doc-subtitle">Invoice</div>
        </div>
        {% if invoice.tenant and invoice.tenant.logo_data %}
        <img src="{{ invoice.tenant.logo_data }}" class="company-logo" alt="">
        {% endif %}
    </div>

    <!-- 2. Meta -->
    <div class="meta-block">
        <table class="meta-table">
            <tr>
                <td class="meta-label">Nomor faktur</td>
                <td class="meta-value">{{ invoice.invoice_number or '-' }}</td>
            </tr>
            <tr>
                <td class="meta-label">Tanggal</td>
                <td class="meta-value">{{ invoice.invoice_date | date_id }}</td>
            </tr>
            <tr>
                <td class="meta-label">Jatuh tempo</td>
                <td class="meta-value">{{ invoice.due_date | date_id }}</td>
            </tr>
            {% if invoice.ref_no %}
            <tr>
                <td class="meta-label">Referensi</td>
                <td class="meta-value">{{ invoice.ref_no }}</td>
            </tr>
            {% endif %}
        </table>
    </div>

    <!-- 3. Parties -->
    <div class="parties">
        {% if invoice.tenant %}
        <div class="party">
            <div class="party-label">Dari</div>
            <div class="party-name">{{ invoice.tenant.name }}</div>
            {% if invoice.tenant.address %}
            <div class="party-detail">{{ invoice.tenant.address }}</div>
            {% endif %}
            {% if invoice.tenant.phone %}
            <div class="party-detail">{{ invoice.tenant.phone }}</div>
            {% endif %}
        </div>
        {% endif %}
        <div class="party">
            <div class="party-label">Kepada</div>
            <div class="party-name">{{ invoice.customer.name if invoice.customer else (invoice.customer_name or '-') }}</div>
            {% if invoice.customer and invoice.customer.address %}
            <div class="party-detail">{{ invoice.customer.address }}</div>
            {% endif %}
            {% if invoice.customer and invoice.customer.email %}
            <div class="party-detail">{{ invoice.customer.email }}</div>
            {% endif %}
        </div>
    </div>

    <!-- 4. Hero Amount -->
    {% set due_amount = invoice.amount_due if invoice.amount_due is defined else (invoice.total_amount or invoice.amount or invoice.grand_total) %}
    <div class="hero">
        <div class="hero-amount">Rp {{ due_amount | currency }}</div>
        {% if invoice.due_date %}
        <div class="hero-due">Jatuh tempo {{ invoice.due_date | date_id }}</div>
        {% endif %}
    </div>

    <div style="height: 28px;"></div>

    <!-- 5. Line Items -->
    <table class="items-table">
        <thead>
            <tr>
                <th class="col-desc">Deskripsi</th>
                <th class="col-qty">Qty</th>
                <th class="col-price">Harga satuan</th>
                <th class="col-amount">Jumlah</th>
            </tr>
        </thead>
        <tbody>
            {% for item in invoice["items"] %}
            <tr>
                <td class="col-desc">
                    {{ item.product_name or item.description or '-' }}
                    {% if item.batch_no %}
                    <br><span class="text-muted">Batch: {{ item.batch_no }}</span>
                    {% endif %}
                    {% if item.discount_percent and item.discount_percent|float > 0 %}
                    <br><span class="text-muted">Disk. {{ item.discount_percent }}%</span>
                    {% endif %}
                </td>
                <td class="col-qty">{{ "%g" % ((item.qty or item.quantity)|float) }}</td>
                <td class="col-price">Rp {{ (item.price or item.unit_price) | currency }}</td>
                <td class="col-amount">Rp {{ (item.total or item.subtotal) | currency }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <!-- 6. Summary -->
    <div class="summary">
        <table class="summary-table">
            <tr>
                <td class="label">Subtotal</td>
                <td class="value">Rp {{ invoice.subtotal | currency }}</td>
            </tr>
            {% if invoice.item_discount_total and invoice.item_discount_total|float > 0 %}
            <tr>
                <td class="label">Diskon item</td>
                <td class="value">-Rp {{ invoice.item_discount_total | currency }}</td>
            </tr>
            {% endif %}
            {% if invoice.invoice_discount_total and invoice.invoice_discount_total|float > 0 %}
            <tr>
                <td class="label">Diskon faktur</td>
                <td class="value">-Rp {{ invoice.invoice_discount_total | currency }}</td>
            </tr>
            {% endif %}
            {% if invoice.discount_amount and invoice.discount_amount|float > 0 %}
            <tr>
                <td class="label">Diskon</td>
                <td class="value">-Rp {{ invoice.discount_amount | currency }}</td>
            </tr>
            {% endif %}
            {% if invoice.cash_discount_total and invoice.cash_discount_total|float > 0 %}
            <tr>
                <td class="label">Diskon tunai</td>
                <td class="value">-Rp {{ invoice.cash_discount_total | currency }}</td>
            </tr>
            {% endif %}
            {% if invoice.tax_rate and invoice.tax_rate|float > 0 %}
            <tr>
                <td class="label">DPP</td>
                <td class="value">Rp {{ invoice.dpp | currency }}</td>
            </tr>
            <tr>
                <td class="label">PPN ({{ invoice.tax_rate }}%)</td>
                <td class="value">Rp {{ invoice.tax_amount | currency }}</td>
            </tr>
            {% endif %}
            <tr class="total-row">
                <td class="label">Total</td>
                <td class="value">Rp {{ (invoice.total_amount or invoice.amount or invoice.grand_total) | currency }}</td>
            </tr>
            {% if invoice.amount_paid and invoice.amount_paid|float > 0 %}
            <tr class="paid-row">
                <td class="label">Dibayar</td>
                <td class="value">Rp {{ invoice.amount_paid | currency }}</td>
            </tr>
            <tr class="due-row">
                <td class="label">Sisa tagihan</td>
                <td class="value">Rp {{ invoice.amount_due | currency }}</td>
            </tr>
            {% endif %}
        </table>
    </div>

    {% if invoice.notes %}
    <div class="notes-section">
        <div class="notes-label">Catatan</div>
        <div class="notes-text">{{ invoice.notes }}</div>
    </div>
    {% endif %}

    <!-- 7. Footer -->
    <div class="footer-line">
        Dicetak {{ generated_at | date_id }}
    </div>

</div>
</body>
</html>
