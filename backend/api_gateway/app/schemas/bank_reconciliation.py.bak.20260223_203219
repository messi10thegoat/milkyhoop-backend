# =============================================================================
# PHASE 5: AGENTIC RECONCILIATION CONTRACTS
# =============================================================================


class ReconAction(BaseModel):
    """A single reconciliation action proposed by the LLM."""
    action_type: str  # 'match' | 'categorize' | 'exclude' | 'create_rule'
    statement_line_id: str
    transaction_id: Optional[str] = None  # for 'match'
    transaction_ids: Optional[List[str]] = None  # for multi-match
    category_account_id: Optional[str] = None  # for 'categorize'
    category_description: Optional[str] = None
    reason: str = ""
    confidence: str = "medium"


class ReconActionPlan(BaseModel):
    """LLM-generated action plan for unmatched items."""
    actions: List[ReconAction]
    summary: str = ""
    total_actions: int = 0
    estimated_resolution: int = 0  # how many items this resolves


class AgenticReconcileRequest(BaseModel):
    """Request for agentic reconciliation."""
    max_actions: int = 20
    include_categorize: bool = True
    include_exclude: bool = True


class AgenticReconcileResponse(BaseModel):
    """Response from agentic reconciliation."""
    action_plan: ReconActionPlan
    session_stats: SessionStatistics


class ConfirmBatchRequest(BaseModel):
    """Request to confirm a batch of match actions."""
    actions: List[ReconAction]


class ConfirmBatchResponse(BaseModel):
    """Response for batch confirmation."""
    confirmed: int
    failed: int
    errors: List[str] = []
    session_stats: SessionStatistics


class CategorizeRequest(BaseModel):
    """Request to categorize an unmatched statement line."""
    statement_line_id: str
    account_id: str
    description: Optional[str] = None
    contact_id: Optional[str] = None


class CategorizeResponse(BaseModel):
    """Response for categorization."""
    success: bool
    transaction_id: Optional[str] = None
    match_id: Optional[str] = None
    session_stats: SessionStatistics



