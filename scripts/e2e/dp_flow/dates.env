# dates.env — EXPLICIT forward-ordered date plan for the DP flow (steps -1..9).
# Sourced by every step script so dates never come from a script default. Opening balance
# is the EARLIEST date; every subsequent step is strictly later, matching the business
# chronology the flow requires (DP before invoice, apply after invoice, settle last). All
# within fiscal period July 2026 (OPEN). Rationale: backdating breaks date-ordered bank
# reporting and bank_transactions.running_balance (see issue 2026-07-26-bank-running-balance).
export D_OPENING="2026-07-01"   # bank opening balance (must be first)
export D_BUY="2026-07-02"       # step 0  — supplier bill issue
export D_BUY_DUE="2026-08-01"   # step 0  — supplier bill due
export D_PAYSUP="2026-07-03"    # step 0b — pay supplier
export D_QUOTE="2026-07-04"     # step 1  — Penawaran / quote
export D_SO="2026-07-05"        # step 2  — convert + confirm SO (required_deposit 30%)
export D_TAGIHDP="2026-07-06"   # step 3  — tagih DP (may be absent)
export D_DP="2026-07-07"        # step 4  — customer pays DP -> Uang Muka Pelanggan
export D_INVOICE="2026-07-08"   # step 5  — faktur (defer: AR / Pend. Diterima Dimuka)
export D_APPLYDP="2026-07-09"   # step 6  — apply DP against AR
export D_SHIP="2026-07-12"      # step 7  — pengiriman (COGS + revenue recognition)
export D_SETTLE="2026-07-20"    # step 8  — pelunasan (remaining AR)
export D_CLOSE_PERIOD="2026-07" # step 9  — close July 2026
